{% extends kimai_context.modalRequest ? 'form.html.twig' : 'base.html.twig' %}

{% block main %}
    {% set formEditTemplate = kimai_context.modalRequest ? 'default/_form_modal.html.twig' : 'default/_form.html.twig' %}
    {% set title = reservation.id is null ? 'planner.reservation.create'|trans : reservation.name %}
    {% embed formEditTemplate with {'title': title, 'form': form, 'back': path('planner_reservations')} %}
        {% block form_body %}
            {{ form_widget(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
