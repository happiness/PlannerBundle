{% extends kimai_context.modalRequest ? 'form.html.twig' : 'base.html.twig' %}

{% block main %}
    {% set formEditTemplate = kimai_context.modalRequest ? 'default/_form_modal.html.twig' : 'default/_form.html.twig' %}
    {% embed formEditTemplate with {
        'title': 'planner.confirm_tentative'|trans,
        'form': form,
        'back': path('planner_week', {'date': date}),
        'submit_button': 'planner.confirm_tentative_submit',
    } %}
        {% block form_body %}
            {% if confirmation.empty %}
                <p>{{ 'planner.confirm_tentative_none'|trans({'%project%': confirmation.project.name}) }}</p>
            {% else %}
                <p>{{ 'planner.confirm_tentative_question'|trans({'%project%': confirmation.project.name}) }}</p>
                <ul>
                    <li>{{ 'planner.confirm_tentative_count'|trans({'%count%': confirmation.count}) }}</li>
                    <li>{{ 'planner.confirm_tentative_users'|trans({'%count%': confirmation.userCount}) }}</li>
                    <li>{{ 'planner.confirm_tentative_period'|trans({'%begin%': confirmation.begin|date_short, '%end%': confirmation.end|date_short}) }}</li>
                </ul>
                <p class="text-muted small">{{ 'planner.confirm_tentative_scope'|trans }}</p>
            {% endif %}
            {% if confirmation.skippedCount > 0 %}
                <div class="alert alert-warning mb-0">{{ 'planner.confirm_tentative_skipped'|trans({'%count%': confirmation.skippedCount}) }}</div>
            {% endif %}
            {{ form_rest(form) }}
        {% endblock %}
        {% block submit_button %}
            {% if not confirmation.empty %}
                {{ parent() }}
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
