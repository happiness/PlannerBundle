{% extends kimai_context.modalRequest ? 'form.html.twig' : 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block main %}
    {% set formEditTemplate = kimai_context.modalRequest ? 'default/_form_modal.html.twig' : 'default/_form.html.twig' %}
    {% set formOptions = {
        'title': (activity.id is null ? 'planner.create_entry'|trans : 'planner.edit_entry'|trans),
        'form': form,
        'back': path('planner')
    } %}
    {% embed formEditTemplate with formOptions %}
        {% block form_body %}
            {% if activity.isRecurring and form.edit_mode is defined %}
                <div class="planner-edit-fields">
                    {% if form.user is defined %}
                        {{ form_row(form.user) }}
                    {% endif %}
                    {{ form_row(form.customer) }}
                    {{ form_row(form.project) }}
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.begin) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.end) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.hoursPerDay) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.color) }}
                        </div>
                    </div>
                    {{ form_row(form.comment) }}
                </div>
                <div class="planner-edit-recurring-prompt d-none">
                    <p class="planner-prompt-item-name"><strong>{{ activity.name }}</strong></p>
                    <p>{{ 'planner.edit_recurring_prompt'|trans }}</p>
                    {{ form_widget(form.edit_mode) }}
                </div>
            {% else %}
                {% if form.user is defined %}
                    {{ form_row(form.user) }}
                {% endif %}
                {% if activity.id is null %}
                    <style>
                        .planner-combination { display: inline-flex; align-items: center; max-width: 100%; padding: .2rem .75rem; border-radius: 50rem; font-size: .6875rem; line-height: 1.4; white-space: nowrap; }
                        .planner-combination-customer { overflow: hidden; text-overflow: ellipsis; min-width: 0; max-width: 10rem; }
                    </style>
                    <div class="mb-3 row planner-combinations d-none"
                         data-customer="{{ form.customer.vars.id }}"
                         data-project="{{ form.project.vars.id }}"
                         data-user="{{ form.user is defined ? form.user.vars.id : '' }}"
                         data-initial-user="{{ activity.user.id ?? app.user.id }}"
                         data-url="{{ path('planner_combinations', {user: 0}) }}">
                        <label class="col-form-label col-sm-2">{{ 'planner.suggestions'|trans }}</label>
                        <div class="col-sm-10 d-flex flex-wrap gap-2 align-items-center planner-combinations-list"></div>
                    </div>
                    <script type="text/javascript">
                        (function () {
                            const modal = document.getElementById('remote_form_modal') || document;
                            const box = modal.querySelector('.planner-combinations');
                            if (box === null) {
                                return;
                            }
                            const customer = document.getElementById(box.dataset.customer);
                            const project = document.getElementById(box.dataset.project);
                            const userSelect = box.dataset.user !== '' ? document.getElementById(box.dataset.user) : null;
                            if (customer === null || project === null) {
                                return;
                            }
                            const list = box.querySelector('.planner-combinations-list');

                            const setValue = (select, value) => {
                                select.tomselect !== undefined ? select.tomselect.setValue(value) : (select.value = value, select.dispatchEvent(new Event('change', {bubbles: true})));
                            };

                            // The customer select reloads the project select via the API and dispatches "data-reloaded" when done.
                            const apply = (customerId, projectId) => {
                                if (customer.value === customerId) {
                                    setValue(project, projectId);
                                    return;
                                }
                                const onReloaded = () => {
                                    project.removeEventListener('data-reloaded', onReloaded);
                                    setValue(project, projectId);
                                };
                                project.addEventListener('data-reloaded', onReloaded);
                                setValue(customer, customerId);
                            };

                            const render = (items) => {
                                list.replaceChildren();
                                items.forEach((item) => {
                                    const button = document.createElement('button');
                                    button.type = 'button';
                                    button.className = 'btn btn-sm btn-outline-secondary planner-combination';
                                    button.title = item.customerName + ' › ' + item.projectName;
                                    const customerLabel = document.createElement('span');
                                    customerLabel.className = 'planner-combination-customer';
                                    customerLabel.textContent = item.customerName;
                                    button.append(customerLabel);
                                    button.addEventListener('click', () => apply(String(item.customerId), String(item.projectId)));
                                    list.append(button);
                                });
                                box.classList.toggle('d-none', items.length === 0);
                            };

                            let requestId = 0;
                            const load = (userId) => {
                                const current = ++requestId;
                                fetch(box.dataset.url.replace(/0$/, String(userId)), {headers: {'Accept': 'application/json'}})
                                    .then((response) => response.ok ? response.json() : [])
                                    .then((items) => current === requestId && render(items))
                                    .catch(() => current === requestId && render([]));
                            };

                            if (userSelect !== null) {
                                userSelect.addEventListener('change', () => load(userSelect.value));
                            }
                            load(userSelect !== null && userSelect.value !== '' ? userSelect.value : box.dataset.initialUser);
                        })();
                    </script>
                {% endif %}
                {{ form_row(form.customer) }}
                {{ form_row(form.project) }}
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.begin) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.end) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.hoursPerDay) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.color) }}
                    </div>
                </div>
                {% if form.recurrentWeeks is defined %}
                    {{ form_row(form.recurrentWeeks) }}
                {% endif %}
                {{ form_row(form.comment) }}
            {% endif %}
            {{ form_rest(form) }}
        {% endblock %}
        {% block modal_footer %}
            {% if activity.id is not null and is_granted('delete', activity) %}
                {% set deleteParams = {'id': activity.id} %}
                {% if date is defined and date is not empty %}
                    {% set deleteParams = deleteParams|merge({'date': date}) %}
                {% endif %}
                {% if activity.isRecurring %}
                    <a class="btn btn-outline-danger me-auto modal-ajax-form planner-btn-delete"
                        href="{{ path('planner_activity_delete', deleteParams) }}">
                        {{ icon('delete', true) }}
                        {{ 'action.delete'|trans }}
                    </a>
                {% else %}
                    {% set deleteParams = deleteParams|merge({'token': csrf_token('planner_delete_' ~ activity.id)}) %}
                    <a class="confirmation-link btn btn-outline-danger me-auto planner-btn-delete"
                        href="{{ path('planner_activity_delete', deleteParams) }}"
                        data-question="confirm.delete">
                        {{ icon('delete', true) }}
                        {{ 'action.delete'|trans }}
                    </a>
                {% endif %}
            {% endif %}
            {% if activity.isRecurring and form.edit_mode is defined %}
                <button type="button"
                        class="btn btn-secondary planner-btn-back d-none">
                    {{ 'back'|trans }}
                </button>
                <button type="button"
                        class="btn btn-primary planner-btn-prompt-save"
                        data-hotkey="ctrl+Enter">
                    {{ 'action.save'|trans }}
                </button>
                <button type="submit"
                        class="btn btn-primary modal-form-save planner-btn-real-save d-none"
                        data-loading-text="{{ 'action.save'|trans }}…"
                        id="form_modal_save">
                    {{ 'action.save'|trans }}
                </button>
            {% else %}
                <button type="submit"
                        class="btn btn-primary modal-form-save"
                        data-loading-text="{{ 'action.save'|trans }}…"
                        id="form_modal_save"
                        data-hotkey="ctrl+Enter">
                    {{ 'action.save'|trans }}
                </button>
            {% endif %}
            <button type="button"
                    class="btn btn-cancel"
                    data-bs-dismiss="modal">
                {{ 'action.close'|trans }}
            </button>
        {% endblock %}
        {% block form_after %}
            {% if not kimai_context.modalRequest and activity.id is not null and is_granted('delete', activity) %}
                {% set deleteParams = {'id': activity.id} %}
                {% if date is defined and date is not empty %}
                    {% set deleteParams = deleteParams|merge({'date': date}) %}
                {% endif %}
                <div class="card-footer d-flex justify-content-between border-top">
                    {% if activity.isRecurring %}
                        <a class="btn btn-outline-danger me-auto modal-ajax-form"
                            href="{{ path('planner_activity_delete', deleteParams) }}">
                            {{ icon('delete', true) }}
                            {{ 'action.delete'|trans }}
                        </a>
                    {% else %}
                        {% set deleteParams = deleteParams|merge({'token': csrf_token('planner_delete_' ~ activity.id)}) %}
                        <a class="confirmation-link btn btn-outline-danger me-auto"
                            href="{{ path('planner_activity_delete', deleteParams) }}"
                            data-question="confirm.delete">
                            {{ icon('delete', true) }}
                            {{ 'action.delete'|trans }}
                        </a>
                    {% endif %}
                </div>
            {% endif %}
            {% if activity.isRecurring and form.edit_mode is defined %}
                <script type="text/javascript">
                    (function() {
                        const modal = document.getElementById('remote_form_modal') || document;
                        const form = modal.querySelector('form');
                        const fields = modal.querySelector('.planner-edit-fields');
                        const prompt = modal.querySelector('.planner-edit-recurring-prompt');
                        const btnPromptSave = modal.querySelector('.planner-btn-prompt-save');
                        const btnRealSave = modal.querySelector('.planner-btn-real-save');
                        const btnBack = modal.querySelector('.planner-btn-back');
                        const btnDelete = modal.querySelector('.planner-btn-delete');
                        
                        if (btnPromptSave && fields && prompt) {
                            btnPromptSave.addEventListener('click', function(e) {
                                e.preventDefault();
                                if (form && form.checkValidity && !form.checkValidity()) {
                                    form.reportValidity();
                                    return;
                                }
                                fields.classList.add('d-none');
                                prompt.classList.remove('d-none');
                                btnPromptSave.classList.add('d-none');
                                if (btnDelete) btnDelete.classList.add('d-none');
                                if (btnBack) btnBack.classList.remove('d-none');
                                if (btnRealSave) btnRealSave.classList.remove('d-none');
                            });
                        }

                        if (btnBack && fields && prompt) {
                            btnBack.addEventListener('click', function(e) {
                                e.preventDefault();
                                prompt.classList.add('d-none');
                                fields.classList.remove('d-none');
                                if (btnRealSave) btnRealSave.classList.add('d-none');
                                btnBack.classList.add('d-none');
                                if (btnDelete) btnDelete.classList.remove('d-none');
                                if (btnPromptSave) btnPromptSave.classList.remove('d-none');
                            });
                        }
                    })();
                </script>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
