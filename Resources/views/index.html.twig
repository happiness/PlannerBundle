{% extends 'page_setup.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block page_class %}planner-page{% endblock %}

{% block main %}
    <div class="page-header d-print-none">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col">
                    <div class="btn-group week-picker-btn-group" role="group" aria-label="{{ 'planner.title'|trans }}">
                        <a href="{{ path('planner_week', {'date': prevWeek}) }}" class="btn btn-left btn-icon">
                            {{ icon('left') }}
                        </a>
                        <a href="{{ path('planner_week', {'date': todayWeek}) }}" class="btn btn-default">
                            {{ currentWeek|month_name }} {{ currentWeek|date('Y') }}
                            -
                            {{ 'stats.workingTimeWeekShort'|trans({'%week%': todayWeek|date('W')}) }}
                        </a>
                        <a href="{{ path('planner_week', {'date': nextWeek}) }}" class="btn btn-right btn-icon">
                            {{ icon('right') }}
                        </a>
                    </div>
                </div>

                {% if canCreate %}
                <div class="col-auto ms-auto d-print-none">
                    <div class="page-actions">
                        {{ widgets.card_tool_button('create', {
                            'class': 'modal-ajax-form',
                            'title': 'planner.planned_activity',
                            'combined': true,
                            'url': path('planner_activity_create', {
                                'date': currentWeek|date('Y-m-d')
                            })
                        }) }}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-fluid">
            <section class="content">
                <div class="card mt-2 mb-3">
                    <div class="card-body p-0">
                        <table class="table table-hover dataTable">
                            <thead class="sticky-top">
                                <tr>
                                    <th class="w-avatar border-bottom p-1" colspan="2"></th>
                                    {% for day in plannerData.dateHeaders %}
                                        <th class="text-center border-bottom{% if day is weekend %} weekend{% endif %}{% if day is today %} today{% endif %} p-1" style="min-width: 140px;">
                                            {{ day|date_weekday }}
                                        </th>
                                    {% endfor %}
                                    <th class="text-center border-bottom p-1">{{ 'planner.capacity'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in plannerData.rows %}
                                    <tr>
                                        <td class="w-avatar align-top p-1 pt-2">{{ widgets.user_avatar(row.user, false, 'avatar-xs') }}</td>
                                        <td class="text-nowrap align-top p-1 pt-2">{{ row.user.displayName }}</td>
                                        {% for day in row.days %}
                                            {% set hasAcitivities = day.activities is not empty  %}
                                            <td class="position-relative align-top border-1 day{% if day.date is weekend %} weekend{% endif %}{% if day.date is today %} today{% endif %} p-1 {{ hasAcitivities ? 'has-activities' : 'no-activities' }}">
                                                {% if canCreate %}
                                                    <a href="{{ path('planner_activity_create', {'user': row.user.id, 'date': day.date|date('Y-m-d')}) }}"
                                                       class="stretched-link cursor-crosshair modal-ajax-form"
                                                       title="{{ 'planner.planned_activity'|trans }}"></a>
                                                {% endif %}

                                                {% for activity in day.activities %}
                                                    <a href="{{ path('planner_activity_edit', {'id': activity.id}) }}"
                                                       class="position-relative z-2 d-block p-1 my-1 rounded text-decoration-none modal-ajax-form shadow-sm"
                                                       style="background-color: {{ activity.colorSafe }}; color: {{ activity.colorSafe|font_contrast }};"
                                                       title="{{ activity.title }}{% if activity.comment %}&#10;{{ activity.comment }}{% endif %}">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span class="text-truncate small">{{ activity.title }}</span>
                                                            <span class="badge badge-sm ms-1">{{ activity.hoursPerDay }}h</span>
                                                        </div>
                                                    </a>
                                                {% endfor %}
                                            </td>
                                        {% endfor %}
                                        <td class="align-top text-center small p-1">
                                            <div>
                                                <span class="{% if row.isOverAllocated %}text-danger{% elseif row.isBalanced %}text-success{% else %}text-primary{% endif %}">
                                                    {{ row.totalPlannedHours }}h</span><span class="text-muted">/{{ row.totalExpectedHours }}h</span>
                                                {% set pct = row.totalExpectedHours > 0 ? ((row.totalPlannedHours / row.totalExpectedHours) * 100)|round : 0 %}
                                                <span>({{ pct }}%)</span>
                                            </div>
                                            <div>
                                                {{ 'planner.actual_hours'|trans }}: <strong>{{ row.totalActualHours }}h</strong>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="10" class="text-center text-muted p-1">
                                            {{ 'error.no_entries_found'|trans }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            {% if plannerData.rows|length > 0 %}
                                <tfoot>
                                    <tr class="bg-light fw-bold">
                                        <td class="text-right p-1" colspan="2">&nbsp;</td>
                                        {% for day in plannerData.dateHeaders %}
                                            {% set dayTotalPlanned = plannerData.getTotalPlannedHoursForDay(day) %}
                                            {% set dayTotalActual = plannerData.getTotalActualHoursForDay(day) %}
                                            <td class="align-top text-center p-1">
                                                <div>{{ dayTotalPlanned }}h</div>
                                                {% if dayTotalActual > 0 %}
                                                    <div class="small text-muted fw-normal">{{ dayTotalActual }}h</div>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                        <td class="align-top text-center p-1">
                                            <div>{{ plannerData.totalPlannedHours }}h / {{ plannerData.totalExpectedHours }}h</div>
                                            {% if plannerData.totalActualHours > 0 %}
                                                <div class="small text-muted fw-normal">{{ 'planner.actual_hours'|trans }}: {{ plannerData.totalActualHours }}h</div>
                                            {% endif %}
                                        </td>
                                    </tr>
                                </tfoot>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        td.day {
            height: 100%;
        }
        td.day:hover {
            background-color: #ccc;
        }
        td.day.has-activities {
            padding-bottom: 1rem !important;
        }
        th.border-bottom {
            border-bottom: 1px solid #e5e7eb !important;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        document.addEventListener('kimai.initialized', function() {
            // Soft reload (reloads content area without full browser refresh)
            KimaiReloadPageWidget.create('kimai.plannerActivityUpdate');
        });
    </script>
{% endblock %}