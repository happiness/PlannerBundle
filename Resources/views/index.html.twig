{% extends 'page_setup.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block page_class %}planner-page{% endblock %}

{% block main %}
    <div class="page-header d-print-none">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col">
                    <div class="btn-group week-picker-btn-group" role="group" aria-label="{{ 'planner.title'|trans }}">
                        <a href="{{ path('planner_week', {'date': prevWeek}) }}" class="btn btn-left btn-icon">
                            {{ icon('left') }}
                        </a>
                        <a href="{{ path('planner_week', {'date': todayWeek}) }}" class="btn btn-default">
                            {{ currentWeek|month_name }} {{ currentWeek|date('Y') }}
                            -
                            {{ 'stats.workingTimeWeekShort'|trans({'%week%': todayWeek|date('W')}) }}
                        </a>
                        <a href="{{ path('planner_week', {'date': nextWeek}) }}" class="btn btn-right btn-icon">
                            {{ icon('right') }}
                        </a>
                    </div>
                    <a href="{{ path('planner_week', {'date': todayWeek}) }}" class="btn">
                        {{ icon('calendar', true) }}
                        {{ 'planner.this_week'|trans }}
                    </a>
                    <button type="button" class="btn planner-toggle-all planner-expand-all">
                        {{ icon('fas fa-plus-minus', true) }}
                        {{ 'planner.toggle_all'|trans }}
                    </button>
                </div>

                <div class="col-auto ms-auto d-print-none d-flex gap-2 align-items-center">
                    {% if toolbarForm is defined and toolbarForm is not null %}
                        {% form_theme toolbarForm 'form/search.html.twig' %}
                        {{ form_start(toolbarForm, {'attr': {'class': 'searchform d-flex align-items-center'}}) }}
                        {% set filterCount = query.countFilter() %}
                        <div class="input-group inline-search position-static">
                            <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="false" aria-haspopup="true" aria-expanded="false" id="search-dropdown-btn" title="{{ 'search_filter'|trans }}">
                                {{ icon('filter', true) }}
                                {% if filterCount > 0 %}<span class="badge badge-notification bg-primary text-primary-fg ms-1 d-none d-sm-inline">{{ filterCount }}</span>{% endif %}
                            </button>
                            <div class="dropdown-menu p-3 search-dropdown" data-popper-placement="bottom-start" aria-labelledby="search-dropdown-btn">
                                {{ form_rest(toolbarForm) }}
                                <div class="row mt-3">
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-primary">{{ 'search'|trans }}</button>
                                    </div>
                                </div>
                            </div>
                            <span class="input-group-text">
                                {% set bookmarkToken = csrf_token('search') %}
                                {% set searchBtnClass = 'btn btn-icon btn-sm btn-ghost-secondary p-1' %}
                                <input type="hidden" name="_token" value="{{ bookmarkToken }}">
                                <button type="submit" class="{{ searchBtnClass }}" data-toggle="tooltip" title="{{ 'search'|trans }}">
                                    {{ icon('search') }}
                                </button>

                                {% if toolbarForm.vars.data.bookmark %}
                                <a class="{{ searchBtnClass }} text-yellow" href="?_token={{ bookmarkToken }}&removeDefaultQuery={{ toolbarForm.vars.data.bookmark.name }}" data-toggle="tooltip" title="{{ 'remove_default'|trans }}" id="removeDefaultQuery">
                                    {{ icon('bookmarked') }}
                                </a>
                                {% elseif filterCount > 0 %}
                                <button class="{{ searchBtnClass }}" type="submit" id="setDefaultQuery" name="setDefaultQuery" data-toggle="tooltip" title="{{ 'set_as_default'|trans }}">
                                    {{ icon('bookmark') }}
                                </button>
                                {% endif %}

                                {% if filterCount > 0 and not toolbarForm.vars.data.isBookmarkSearch() %}
                                    <a class="{{ searchBtnClass }} text-orange" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}" data-toggle="tooltip" title="{{ 'remove_filter'|trans }}">
                                        {{ icon('cancel') }}
                                    </a>
                                {% endif %}
                            </span>
                        </div>
                        <input type="hidden" name="performSearch" value="performSearch" />
                        {{ form_end(toolbarForm) }}
                    {% endif %}

                    {% if canCreate %}
                    <div class="page-actions">
                        {{ widgets.card_tool_button('create', {
                            'class': 'modal-ajax-form',
                            'title': 'planner.planned_activity',
                            'combined': true,
                            'url': path('planner_activity_create', {
                                'date': currentWeek|date('Y-m-d')
                            })
                        }) }}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-fluid">
            <section class="content">
                <div class="card mt-2 mb-3">
                    <div class="card-body p-0">
                        <table class="table table-hover dataTable">
                            <thead class="sticky-top">
                                <tr>
                                    <th class="w-avatar border-bottom p-1" colspan="2"></th>
                                    {% for day in plannerData.dateHeaders %}
                                        <th class="text-center border-bottom{% if day is weekend %} weekend{% endif %}{% if day is today %} today{% endif %} p-1" style="min-width: 140px;">
                                            {{ day|date_weekday }}
                                        </th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in plannerData.rows %}
                                    {% set pct = row.plannedPercentage %}
                                    {% set barColorClass = row.isOverAllocated ? 'planner-bar-danger' : (row.totalPlannedHours > 0 ? 'planner-bar-success' : 'planner-bar-muted') %}
                                    <tr class="planner-row planner-row-summary is-collapsed" data-user-id="{{ row.user.id }}">
                                        <td class="w-avatar align-middle p-1 planner-user-cell">{{ widgets.user_avatar(row.user, false, 'avatar-sm') }}</td>
                                        <td class="text-nowrap align-middle p-1 planner-user-cell">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>{{ row.user.displayName }}</div>
                                                <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary planner-user-toggle m-2 p-0" aria-expanded="false" title="{{ 'planner.toggle_activities'|trans }}">
                                                    <span class="toggle-icon d-inline-block">{{ icon('right') }}</span>
                                                </button>
                                            </div>
                                        </td>
                                        <td colspan="{{ plannerData.dateHeaders|length }}" class="planner-week-summary align-middle p-0">
                                            <div class="planner-summary-bar {{ barColorClass }}">
                                                <div class="planner-summary-badge">
                                                    <div class="planner-summary-pct">{{ pct }}%</div>
                                                    <div class="planner-summary-hours">
                                                        {{ row.totalPlannedHours }}/{{ row.totalExpectedHours }} hrs ({{ row.totalActualHours }} hrs)
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr class="planner-row planner-row-details is-collapsed" data-user-id="{{ row.user.id }}">
                                        <td colspan="2" class="planner-user-cell p-1 border-top-0"></td>
                                        {% for day in row.days %}
                                            {% set hasActivities = day.activities is not empty  %}
                                            <td class="position-relative align-top border-1 day{% if day.date is weekend %} weekend{% endif %}{% if day.date is today %} today{% endif %} p-1 {{ hasActivities ? 'has-activities' : 'no-activities' }}">
                                                {% if canCreate %}
                                                    <a href="{{ path('planner_activity_create', {'user': row.user.id, 'date': day.date|date('Y-m-d')}) }}"
                                                       class="stretched-link cursor-crosshair modal-ajax-form"
                                                       title="{{ 'planner.planned_activity'|trans }}"></a>
                                                {% endif %}

                                                {% for activity in day.activities %}
                                                    <a href="{{ path('planner_activity_edit', {'id': activity.id}) }}"
                                                       class="planner-activity position-relative z-2 d-block p-1 my-1 rounded text-decoration-none modal-ajax-form shadow-sm"
                                                       style="background-color: {{ activity.colorSafe }}; color: {{ activity.colorSafe|font_contrast }};"
                                                       title="{{ activity.title }}">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span class="text-truncate small">{% if activity.hasComment %}<span title="{{ activity.comment|u.truncate(1024, '...') }}">{{ icon('comment') }}</span> {% endif %}{{ activity.title }}</span>
                                                            <span class="badge badge-sm ms-1 flex-shrink-0">{{ activity.hoursPerDay }}h</span>
                                                        </div>
                                                    </a>
                                                {% endfor %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="{{ (plannerData.dateHeaders|length) + 2 }}" class="text-center p-4">
                                            {{ widgets.nothing_found() }}
                                            {% if query is defined and query.countFilter() > 0 %}
                                                <div class="mt-2">
                                                    <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}" class="btn btn-outline-secondary btn-sm">
                                                        {{ icon('cancel') }} {{ 'remove_filter'|trans }}
                                                    </a>
                                                </div>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            {% if plannerData.rows|length > 0 %}
                                <tfoot>
                                    <tr class="bg-light fw-bold">
                                        <td class="text-right p-1" colspan="2">
                                            <div>{{ plannerData.totalPlannedHours }}h / {{ plannerData.totalExpectedHours }}h</div>
                                            {% if plannerData.totalActualHours > 0 %}
                                                <div class="small text-muted fw-normal">{{ 'planner.actual_hours'|trans }}: {{ plannerData.totalActualHours }}h</div>
                                            {% endif %}
                                        </td>
                                        {% for day in plannerData.dateHeaders %}
                                            {% set dayTotalPlanned = plannerData.getTotalPlannedHoursForDay(day) %}
                                            {% set dayTotalActual = plannerData.getTotalActualHoursForDay(day) %}
                                            <td class="align-top text-center p-1">
                                                <div>{{ dayTotalPlanned }}h</div>
                                                {% if dayTotalActual > 0 %}
                                                    <div class="small text-muted fw-normal">{{ dayTotalActual }}h</div>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                </tfoot>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        td.day {
            height: 48px;
        }
        td.day:hover {
            background-color: #ccc;
        }
        tr.is-expanded td.day.has-activities {
            padding-bottom: 1rem !important;
        }
        .planner-activity {
            min-width: 100%;
            max-width: 8rem;
        }
        td.planner-week-summary {
            padding: 0 !important;
            vertical-align: middle;
        }
        .planner-summary-bar {
            width: 100%;
            height: 100%;
            min-height: 48px;
            display: flex;
            align-items: stretch;
        }
        .planner-bar-success {
            background-color: #5fa675;
        }
        .planner-bar-danger {
            background-color: #db5c5c;
        }
        .planner-bar-muted {
            background-color: #94a3b8;
        }
        .planner-summary-badge {
            background-color: rgba(0, 0, 0, 0.35);
            color: #ffffff;
            padding: 4px 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 140px;
            flex-shrink: 0;
        }
        .planner-summary-pct {
            font-weight: 700;
            font-size: 1.1rem;
            line-height: 1.2;
        }
        .planner-summary-hours {
            font-size: 0.8rem;
            line-height: 1.2;
            white-space: nowrap;
            color: rgba(255, 255, 255, 0.95);
        }
        .planner-user-cell {
            cursor: pointer;
            user-select: none;
        }
        .planner-user-toggle {
            line-height: 1;
        }
        .planner-user-toggle .toggle-icon {
            transition: transform 0.15s ease-in-out;
        }
        .planner-user-toggle[aria-expanded="true"] .toggle-icon,
        tr.is-expanded .planner-user-toggle .toggle-icon {
            transform: rotate(90deg);
        }
        tr.planner-row-summary {
            display: table-row;
        }
        tr.planner-row-details.is-collapsed {
            display: none;
        }
        tr.planner-row-details.is-expanded {
            display: table-row;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        function getPlannerUserToggleStates() {
            try {
                if (typeof KimaiStorage !== 'undefined') {
                    return KimaiStorage.get('planner_user_toggle_states') || {};
                }
                const data = localStorage.getItem('planner_user_toggle_states');
                return data ? JSON.parse(data) : {};
            } catch (e) {
                return {};
            }
        }

        function savePlannerUserToggleState(userId, isExpanded) {
            try {
                const states = getPlannerUserToggleStates();
                states[userId] = isExpanded;
                if (typeof KimaiStorage !== 'undefined') {
                    KimaiStorage.set('planner_user_toggle_states', states);
                } else {
                    localStorage.setItem('planner_user_toggle_states', JSON.stringify(states));
                }
            } catch (e) {
                // ignore storage error
            }
        }

        function restorePlannerUserToggleStates() {
            const states = getPlannerUserToggleStates();
            document.querySelectorAll('.planner-row[data-user-id]').forEach(function(row) {
                const userId = row.getAttribute('data-user-id');
                if (userId && states[userId] !== undefined) {
                    const isExpanded = !!states[userId];
                    row.classList.toggle('is-expanded', isExpanded);
                    row.classList.toggle('is-collapsed', !isExpanded);
                    const toggleBtn = row.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                    }
                }
            });
        }

        document.addEventListener('kimai.initialized', function() {
            // Soft reload (reloads content area without full browser refresh)
            KimaiReloadPageWidget.create('kimai.plannerActivityUpdate');
            restorePlannerUserToggleStates();
        });

        document.addEventListener('kimai.reloadPage', function() {
            restorePlannerUserToggleStates();
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', restorePlannerUserToggleStates);
        } else {
            restorePlannerUserToggleStates();
        }

        document.addEventListener('click', function(e) {
            const toggleAllBtn = e.target.closest('.planner-toggle-all, .planner-expand-all');
            if (toggleAllBtn) {
                e.preventDefault();
                const detailsRows = Array.from(document.querySelectorAll('tr.planner-row-details[data-user-id]'));
                const anyCollapsed = detailsRows.some(function(r) {
                    return r.classList.contains('is-collapsed') || !r.classList.contains('is-expanded');
                });
                const willExpand = detailsRows.length === 0 || anyCollapsed;

                const states = getPlannerUserToggleStates();
                document.querySelectorAll('.planner-row[data-user-id]').forEach(function(r) {
                    r.classList.toggle('is-expanded', willExpand);
                    r.classList.toggle('is-collapsed', !willExpand);
                    const toggleBtn = r.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', willExpand ? 'true' : 'false');
                    }
                    const userId = r.getAttribute('data-user-id');
                    if (userId) {
                        states[userId] = willExpand;
                    }
                });
                try {
                    if (typeof KimaiStorage !== 'undefined') {
                        KimaiStorage.set('planner_user_toggle_states', states);
                    } else {
                        localStorage.setItem('planner_user_toggle_states', JSON.stringify(states));
                    }
                } catch (err) {
                    // ignore storage error
                }
                return;
            }

            const userCell = e.target.closest('.planner-user-cell');
            if (!userCell) {
                return;
            }

            if (e.target.closest('a')) {
                return;
            }

            e.preventDefault();

            const row = userCell.closest('tr');
            if (!row) {
                return;
            }

            const userId = row.getAttribute('data-user-id');
            const isExpanded = row.classList.contains('is-expanded');
            const willExpand = !isExpanded;

            if (userId) {
                document.querySelectorAll('.planner-row[data-user-id="' + userId + '"]').forEach(function(r) {
                    r.classList.toggle('is-expanded', willExpand);
                    r.classList.toggle('is-collapsed', !willExpand);
                    const toggleBtn = r.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', willExpand ? 'true' : 'false');
                    }
                });
                savePlannerUserToggleState(userId, willExpand);
            }
        });
    </script>
{% endblock %}
