{% extends 'page_setup.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block page_class %}planner-page{% endblock %}

{% block main %}
    <div class="page-header d-print-none">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col">
                    <div class="btn-group week-picker-btn-group" role="group" aria-label="{{ 'planner.title'|trans }}">
                        <a href="{{ path('planner_week', {'date': prevWeek}) }}" class="btn btn-left btn-icon">
                            {{ icon('left') }}
                        </a>
                        <span class="btn btn-default pe-none">
                            {{ currentWeek|month_name(true) }}
                            -
                            {{ 'stats.workingTimeWeekShort'|trans({'%week%': currentWeek|date('W')}) }}
                            {% if weeks > 1 %}
                                {% set lastWeek = currentWeek.modify('+' ~ (weeks - 1) ~ ' week') %}
                                &ndash; {{ 'stats.workingTimeWeekShort'|trans({'%week%': lastWeek|date('W')}) }}
                            {% endif %}
                        </span>
                        <a href="{{ path('planner_week', {'date': nextWeek}) }}" class="btn btn-right btn-icon">
                            {{ icon('right') }}
                        </a>
                    </div>
                    <a href="{{ path('planner_week', {'date': todayWeek}) }}" class="btn">
                        {{ icon('calendar', true) }}
                        {{ 'planner.this_week'|trans }}
                    </a>
                    <div class="btn-group" role="group" aria-label="{{ 'planner.weeks'|trans }}" title="{{ 'planner.weeks'|trans }}">
                        {% for option in weekOptions %}
                            <a href="{{ path('planner_week', {'date': currentWeek|date('Y-m-d'), 'weeks': option}) }}" class="btn{% if option == weeks %} active{% endif %}">{{ 'planner.weeks_option'|trans({'%count%': option}) }}</a>
                        {% endfor %}
                    </div>
                    <button type="button" class="btn planner-toggle-all planner-expand-all">
                        {{ icon('fas fa-plus-minus', true) }}
                        {{ 'planner.toggle_all'|trans }}
                    </button>
                </div>

                <div class="col-auto ms-auto d-print-none d-flex gap-2 align-items-center">
                    {% if toolbarForm is defined and toolbarForm is not null %}
                        {% form_theme toolbarForm 'form/search.html.twig' %}
                        {{ form_start(toolbarForm, {'attr': {'class': 'searchform d-flex align-items-center'}}) }}
                        {% set filterCount = query.countFilter() %}
                        <div class="input-group inline-search position-static">
                            <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="false" aria-haspopup="true" aria-expanded="false" id="search-dropdown-btn" title="{{ 'search_filter'|trans }}">
                                {{ icon('filter', true) }}
                                {% if filterCount > 0 %}<span class="badge badge-notification bg-primary text-primary-fg ms-1 d-none d-sm-inline">{{ filterCount }}</span>{% endif %}
                            </button>
                            <div class="dropdown-menu p-3 search-dropdown" data-popper-placement="bottom-start" aria-labelledby="search-dropdown-btn">
                                {{ form_rest(toolbarForm) }}
                                <div class="row mt-3">
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-primary">{{ 'search'|trans }}</button>
                                    </div>
                                </div>
                            </div>
                            <span class="input-group-text">
                                {% set bookmarkToken = csrf_token('search') %}
                                {% set searchBtnClass = 'btn btn-icon btn-sm btn-ghost-secondary p-1' %}
                                <input type="hidden" name="_token" value="{{ bookmarkToken }}">
                                <button type="submit" class="{{ searchBtnClass }}" data-toggle="tooltip" title="{{ 'search'|trans }}">
                                    {{ icon('search') }}
                                </button>

                                {% if toolbarForm.vars.data.bookmark %}
                                <a class="{{ searchBtnClass }} text-yellow" href="?_token={{ bookmarkToken }}&removeDefaultQuery={{ toolbarForm.vars.data.bookmark.name }}" data-toggle="tooltip" title="{{ 'remove_default'|trans }}" id="removeDefaultQuery">
                                    {{ icon('bookmarked') }}
                                </a>
                                {% elseif filterCount > 0 %}
                                <button class="{{ searchBtnClass }}" type="submit" id="setDefaultQuery" name="setDefaultQuery" data-toggle="tooltip" title="{{ 'set_as_default'|trans }}">
                                    {{ icon('bookmark') }}
                                </button>
                                {% endif %}

                                {% if filterCount > 0 and not toolbarForm.vars.data.isBookmarkSearch() %}
                                    <a class="{{ searchBtnClass }} text-orange" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}" data-toggle="tooltip" title="{{ 'remove_filter'|trans }}">
                                        {{ icon('cancel') }}
                                    </a>
                                {% endif %}
                            </span>
                        </div>
                        <input type="hidden" name="performSearch" value="performSearch" />
                        {{ form_end(toolbarForm) }}
                    {% endif %}

                    {% if canCreate %}
                    <div class="page-actions">
                        {{ widgets.card_tool_button('create', {
                            'class': 'modal-ajax-form',
                            'title': 'planner.planned_activity',
                            'combined': true,
                            'url': path('planner_activity_create', {
                                'date': currentWeek|date('Y-m-d')
                            })
                        }) }}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-fluid">
            <section class="content">
                <div class="card mt-2 mb-3">
                    <div class="card-body p-0">
                        <table class="table table-hover dataTable" data-planner-move-token="{{ csrf_token('planner_move') }}" data-planner-move-error="{{ 'planner.move_error'|trans }}"{% if canCreate %} data-planner-create-url="{{ path('planner_activity_create') }}"{% endif %}>
                            <colgroup>
                                <col span="2">
                                {% for day in plannerData.dateHeaders %}
                                    <col{% if day is today %} class="today"{% endif %}>
                                {% endfor %}
                            </colgroup>
                            <thead class="sticky-top">
                                {% set compact = weeks > 1 %}
                                {% if compact %}
                                    <tr>
                                        <th class="border-bottom p-1" colspan="2"></th>
                                        {% for week in plannerData.dateHeaders|batch(7) %}
                                            <th class="text-center border-bottom border-start p-1" colspan="7">
                                                {% set weekStart = week|first %}
                                                {% set weekEnd = week|last %}
                                                <span class="badge bg-blue-lt me-1">{{ 'planner.week_header'|trans({'%week%': weekStart|date('W')}) }}</span>
                                                <span class="text-muted fw-normal">
                                                    {%- if weekStart|date('n') == weekEnd|date('n') -%}
                                                        {{ weekStart|date('j') }}-{{ weekEnd|date('j') }} {{ weekEnd|month_name|slice(0, 3)|lower }}
                                                    {%- else -%}
                                                        {{ weekStart|date('j') }} {{ weekStart|month_name|slice(0, 3)|lower }} - {{ weekEnd|date('j') }} {{ weekEnd|month_name|slice(0, 3)|lower }}
                                                    {%- endif -%}
                                                </span>
                                            </th>
                                        {% endfor %}
                                    </tr>
                                {% endif %}
                                <tr>
                                    <th class="w-avatar border-bottom p-1" colspan="2"></th>
                                    {% for day in plannerData.dateHeaders %}
                                        <th data-planner-day="{{ day|date('Y-m-d') }}" class="text-center border-bottom{% if loop.index0 % 7 == 0 %} border-start{% endif %}{% if day is weekend %} weekend{% endif %}{% if day is today %} today{% endif %} p-1" style="min-width: {{ compact ? 44 : 110 }}px;">
                                            {{ day|date('j') }}
                                        </th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in plannerData.rows %}
                                    <tr class="planner-row planner-row-summary is-collapsed" data-user-id="{{ row.user.id }}">
                                        <td class="w-avatar align-middle p-1 planner-user-cell">{{ widgets.user_avatar(row.user, false, 'avatar-sm') }}</td>
                                        <td class="text-nowrap align-middle p-1 planner-user-cell">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>{{ row.user.displayName }}</div>
                                                <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary planner-user-toggle m-2 p-0" aria-expanded="false" title="{{ 'planner.toggle_activities'|trans }}">
                                                    <span class="toggle-icon d-inline-block">{{ icon('right') }}</span>
                                                </button>
                                            </div>
                                        </td>
                                        {% for week in row.weeks %}
                                            {# amber with space left, green when full, red when overbooked, like the day cells below #}
                                            {% if week.isOverAllocated %}
                                                {% set barColorClass = 'planner-bar-danger' %}
                                            {% elseif week.totalPlannedHours > 0 and week.isBalanced %}
                                                {% set barColorClass = 'planner-bar-success' %}
                                            {% elseif week.totalPlannedHours > 0 %}
                                                {% set barColorClass = 'planner-bar-warning' %}
                                            {% else %}
                                                {% set barColorClass = 'planner-bar-muted' %}
                                            {% endif %}
                                            <td colspan="{{ week.days|length }}" class="planner-week-summary align-middle p-0{% if compact %} border-start{% endif %}">
                                                <div class="planner-summary-bar {{ barColorClass }}">
                                                    <div class="planner-summary-badge">
                                                        <div class="planner-summary-pct">{{ week.plannedPercentage }}%</div>
                                                        <div class="planner-summary-hours">
                                                            {{ week.totalPlannedHours }}/{{ week.totalExpectedHours }} hrs ({{ week.totalActualHours }} hrs)
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    {# planned against contract hours per day, aligned with the day columns and always visible #}
                                    <tr class="planner-row-days">
                                        <td colspan="2" class="p-0 border-top-0"></td>
                                        {% for day in row.days %}
                                            {# the cell fills up to the planned share of the day: amber with space left, green when full, red when overbooked #}
                                            {% if day.isOverAllocated %}
                                                {% set dayClass = 'planner-day-danger' %}
                                                {% set dayFill = 100 %}
                                            {% elseif day.plannedHours > 0 and day.isBalanced %}
                                                {% set dayClass = 'planner-day-success' %}
                                                {% set dayFill = 100 %}
                                            {% elseif day.plannedHours > 0 %}
                                                {% set dayClass = 'planner-day-warning' %}
                                                {% set dayFill = day.plannedPercentage %}
                                            {% else %}
                                                {% set dayClass = 'planner-day-muted' %}
                                                {% set dayFill = 0 %}
                                            {% endif %}
                                            {% set dayHours = day.plannedHours ~ '/' ~ day.expectedHours ~ ' hrs (' ~ day.actualHours ~ ' hrs)' %}
                                            <td class="planner-day-summary text-center border-top-0 {{ dayClass }}{% if loop.index0 % 7 == 0 %} border-start{% endif %}{% if day.date is weekend %} weekend{% endif %}{% if day.date is today %} today{% endif %}" style="--planner-day-fill: {{ dayFill }}%;" title="{{ dayHours }}">
                                                {% if day.isWorkingDay %}
                                                    {% if not compact %}<div class="planner-day-hours">{{ day.plannedHours }}/{{ day.expectedHours }}h</div>{% endif %}
                                                    <div class="planner-day-pct">{{ day.plannedPercentage }}%</div>
                                                {% elseif day.plannedHours > 0 %}
                                                    <div class="planner-day-pct">{{ day.plannedHours }}h</div>
                                                {% else %}
                                                    <div class="planner-day-pct">&ndash;</div>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    {% set groups = row.groups %}
                                    {% for group in groups %}
                                        <tr class="planner-row planner-row-details is-collapsed" data-user-id="{{ row.user.id }}"{% if group.customer %} data-customer-id="{{ group.customer.id }}"{% endif %}{% if group.project %} data-project-id="{{ group.project.id }}"{% endif %}>
                                            <td class="planner-group-cell p-1 border-top-0" colspan="2">
                                                <div class="d-flex justify-content-between align-items-center planner-group-label" title="{{ group.customerName }}{% if group.projectName %} / {{ group.projectName }}{% endif %}">
                                                    <div class="text-truncate">
                                                        <span class="fw-bold small">{{ group.customerName }}</span>{% if group.projectName %}<span class="text-muted small"> / {{ group.projectName }}</span>{% endif %}
                                                    </div>
                                                    <span class="text-muted small ms-2 flex-shrink-0">{{ group.getPlannedHours(row.days) }}h</span>
                                                </div>
                                            </td>
                                            {% for segment in group.getSegments(row.days) %}
                                                {% set date = segment.date %}
                                                <td colspan="{{ segment.span }}" class="position-relative align-middle border-1 day{% if date is weekend %} weekend{% endif %}{% if date is today %} today{% endif %} p-1 {{ segment.activities is not empty ? 'has-activities' : 'no-activities' }}"{% if canCreate and segment.activities is empty %} data-planner-date="{{ date|date('Y-m-d') }}"{% endif %}>
                                                    {% if canCreate and segment.activities is empty %}
                                                        <a href="{{ path('planner_activity_create', {'user': row.user.id, 'date': date|date('Y-m-d')}) }}"
                                                           class="stretched-link cursor-crosshair modal-ajax-form"
                                                           title="{{ 'planner.planned_activity'|trans }}"></a>
                                                    {% endif %}
                                                    {% set segmentEnd = date.modify('+' ~ (segment.span - 1) ~ ' day') %}
                                                    {% for activity in segment.activities %}
                                                        {% set canMove = is_granted('edit', activity) %}
                                                        <a href="{{ path('planner_activity_edit', {'id': activity.id, 'date': date|date('Y-m-d')}) }}"
                                                           class="planner-activity position-relative z-2 d-flex justify-content-between align-items-center px-2 py-1 rounded text-decoration-none modal-ajax-form shadow-sm{% if not loop.first %} mt-1{% endif %}{% if canMove %} planner-movable{% endif %}"
                                                           style="background-color: {{ activity.colorSafe }}; color: {{ activity.colorSafe|font_contrast }};"
                                                           {% if canMove %}data-planner-move-url="{{ path('planner_activity_move', {'id': activity.id}) }}" data-planner-begin="{{ activity.begin|date('Y-m-d') }}" data-planner-end="{{ activity.end|date('Y-m-d') }}"{% endif %}
                                                           title="{{ activity.name }} ({{ activity.hoursPerDay }}h){% if activity.hasComment %}: {{ activity.comment|u.truncate(1024, '...') }}{% endif %}">
                                                            {% if canMove and activity.begin|date('Y-m-d') == date|date('Y-m-d') %}<span class="planner-handle planner-handle-start" data-planner-handle="start"></span>{% endif %}
                                                            <span class="text-truncate small">{% if activity.hasComment %}{{ icon('comment') }} {% endif %}{{ activity.hoursPerDay }}h</span>
                                                            {% if canMove and activity.end|date('Y-m-d') == segmentEnd|date('Y-m-d') %}<span class="planner-handle planner-handle-end" data-planner-handle="end"></span>{% endif %}
                                                        </a>
                                                    {% endfor %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                    {# always keep one empty row per user, so new planning can be dragged out #}
                                    <tr class="planner-row planner-row-details is-collapsed" data-user-id="{{ row.user.id }}">
                                        <td colspan="2" class="planner-group-cell p-1 border-top-0"></td>
                                        {% for day in row.days %}
                                            <td class="position-relative border-1 day{% if day.date is weekend %} weekend{% endif %}{% if day.date is today %} today{% endif %} p-1 no-activities"{% if canCreate %} data-planner-date="{{ day.date|date('Y-m-d') }}"{% endif %}>
                                                {% if canCreate %}
                                                    <a href="{{ path('planner_activity_create', {'user': row.user.id, 'date': day.date|date('Y-m-d')}) }}"
                                                       class="stretched-link cursor-crosshair modal-ajax-form"
                                                       title="{{ 'planner.planned_activity'|trans }}"></a>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="{{ (plannerData.dateHeaders|length) + 2 }}" class="text-center p-4">
                                            {{ widgets.nothing_found() }}
                                            {% if query is defined and query.countFilter() > 0 %}
                                                <div class="mt-2">
                                                    <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}" class="btn btn-outline-secondary btn-sm">
                                                        {{ icon('cancel') }} {{ 'remove_filter'|trans }}
                                                    </a>
                                                </div>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            {% if plannerData.rows|length > 0 %}
                                <tfoot>
                                    <tr class="bg-light fw-bold">
                                        <td class="text-right p-1" colspan="2">
                                            <div>{{ plannerData.totalPlannedHours }}h / {{ plannerData.totalExpectedHours }}h</div>
                                            {% if plannerData.totalActualHours > 0 %}
                                                <div class="small text-muted fw-normal">{{ 'planner.actual_hours'|trans }}: {{ plannerData.totalActualHours }}h</div>
                                            {% endif %}
                                        </td>
                                        {% for day in plannerData.dateHeaders %}
                                            {% set dayTotalPlanned = plannerData.getTotalPlannedHoursForDay(day) %}
                                            {% set dayTotalActual = plannerData.getTotalActualHoursForDay(day) %}
                                            <td class="align-top text-center{% if day is today %} today{% endif %} p-1">
                                                <div>{{ dayTotalPlanned }}h</div>
                                                {% if dayTotalActual > 0 %}
                                                    <div class="small text-muted fw-normal">{{ dayTotalActual }}h</div>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                </tfoot>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        td.day {
            height: 36px;
        }
        tr.planner-row-details td.day {
            height: 32px;
        }
        td.day[data-planner-date] {
            user-select: none;
        }
        td.day.planner-drag-selected,
        td.day.planner-drag-selected:hover {
            background-color: transparent !important;
        }
        .planner-drag-preview {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 3;
            pointer-events: none;
            min-height: 1.75rem;
            background-color: rgba(32, 107, 196, 0.55);
            color: #fff;
            border: 1px dashed #206bc4;
        }
        body.planner-dragging {
            cursor: crosshair;
            user-select: none;
        }
        .planner-group-label {
            padding-left: 2.5rem;
            max-width: 18rem;
        }
        col.today {
            background-color: var(--tblr-highlight-bg);
        }
        table.dataTable tbody td.today,
        table.dataTable tfoot td.today {
            background-color: var(--tblr-highlight-bg) !important;
        }
        table.dataTable tbody td.today:hover {
            background-color: #ccc !important;
        }
        td.day:hover {
            background-color: #ccc;
        }
        .planner-activity {
            min-width: 100%;
        }
        .planner-activity.planner-movable {
            cursor: grab;
        }
        .planner-handle {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 8px;
            cursor: ew-resize;
            background-color: rgba(0, 0, 0, 0.25);
            opacity: 0;
            transition: opacity 0.1s ease-in-out;
        }
        .planner-handle-start {
            left: 0;
            border-radius: 0.25rem 0 0 0.25rem;
        }
        .planner-handle-end {
            right: 0;
            border-radius: 0 0.25rem 0.25rem 0;
        }
        .planner-activity:hover .planner-handle,
        body.planner-moving .planner-handle {
            opacity: 1;
        }
        .planner-move-preview {
            position: fixed;
            z-index: 1100;
            pointer-events: none;
            background-color: rgba(32, 107, 196, 0.35);
            border: 1px dashed #206bc4;
            border-radius: 0.25rem;
        }
        body.planner-moving {
            cursor: grabbing;
            user-select: none;
        }
        body.planner-moving .planner-activity {
            opacity: 0.6;
        }
        td.planner-week-summary {
            padding: 0 !important;
            vertical-align: middle;
        }
        .planner-summary-bar {
            width: 100%;
            height: 100%;
            min-height: 48px;
            display: flex;
            align-items: stretch;
        }
        .planner-bar-success {
            background-color: #5fa675;
        }
        .planner-bar-warning {
            background-color: #e0a43a;
        }
        .planner-bar-danger {
            background-color: #db5c5c;
        }
        .planner-bar-muted {
            background-color: #94a3b8;
        }
        .planner-summary-badge {
            background-color: rgba(0, 0, 0, 0.35);
            color: #ffffff;
            padding: 4px 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 140px;
            flex-shrink: 0;
        }
        .planner-summary-pct {
            font-weight: 700;
            font-size: 1.1rem;
            line-height: 1.2;
        }
        .planner-summary-hours {
            font-size: 0.8rem;
            line-height: 1.2;
            white-space: nowrap;
            color: rgba(255, 255, 255, 0.95);
        }
        td.planner-day-summary {
            --planner-day-color: transparent;
            padding: 2px 0 !important;
            font-size: 0.75rem;
            line-height: 1.2;
            white-space: nowrap;
            background-image: linear-gradient(to top, var(--planner-day-color) var(--planner-day-fill, 0%), transparent var(--planner-day-fill, 0%));
        }
        .planner-day-pct {
            font-weight: 600;
        }
        td.planner-day-success {
            --planner-day-color: rgba(95, 166, 117, 0.35);
            color: #2f6b42;
        }
        td.planner-day-warning {
            --planner-day-color: rgba(240, 173, 78, 0.4);
            color: #8a5a12;
        }
        td.planner-day-danger {
            --planner-day-color: rgba(219, 92, 92, 0.4);
            color: #a32626;
        }
        td.planner-day-muted {
            color: #94a3b8;
        }
        /* the dark text above disappears on the tinted cells of the dark theme */
        [data-bs-theme="dark"] td.planner-day-success,
        [data-bs-theme="dark"] td.planner-day-warning,
        [data-bs-theme="dark"] td.planner-day-danger {
            color: #ffffff;
        }
        .planner-user-cell {
            cursor: pointer;
            user-select: none;
        }
        .planner-user-toggle {
            line-height: 1;
        }
        .planner-user-toggle .toggle-icon {
            transition: transform 0.15s ease-in-out;
        }
        .planner-user-toggle[aria-expanded="true"] .toggle-icon,
        tr.is-expanded .planner-user-toggle .toggle-icon {
            transform: rotate(90deg);
        }
        tr.planner-row-summary {
            display: table-row;
        }
        tr.planner-row-details.is-collapsed {
            display: none;
        }
        tr.planner-row-details.is-expanded {
            display: table-row;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        function getPlannerUserToggleStates() {
            try {
                if (typeof KimaiStorage !== 'undefined') {
                    return KimaiStorage.get('planner_user_toggle_states') || {};
                }
                const data = localStorage.getItem('planner_user_toggle_states');
                return data ? JSON.parse(data) : {};
            } catch (e) {
                return {};
            }
        }

        function savePlannerUserToggleState(userId, isExpanded) {
            try {
                const states = getPlannerUserToggleStates();
                states[userId] = isExpanded;
                if (typeof KimaiStorage !== 'undefined') {
                    KimaiStorage.set('planner_user_toggle_states', states);
                } else {
                    localStorage.setItem('planner_user_toggle_states', JSON.stringify(states));
                }
            } catch (e) {
                // ignore storage error
            }
        }

        function restorePlannerUserToggleStates() {
            const states = getPlannerUserToggleStates();
            document.querySelectorAll('.planner-row[data-user-id]').forEach(function(row) {
                const userId = row.getAttribute('data-user-id');
                if (userId && states[userId] !== undefined) {
                    const isExpanded = !!states[userId];
                    row.classList.toggle('is-expanded', isExpanded);
                    row.classList.toggle('is-collapsed', !isExpanded);
                    const toggleBtn = row.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                    }
                }
            });
        }

        document.addEventListener('kimai.initialized', function() {
            // Soft reload (reloads content area without full browser refresh)
            KimaiReloadPageWidget.create('kimai.plannerActivityUpdate');
            restorePlannerUserToggleStates();
        });

        document.addEventListener('kimai.reloadPage', function() {
            restorePlannerUserToggleStates();
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', restorePlannerUserToggleStates);
        } else {
            restorePlannerUserToggleStates();
        }

        document.addEventListener('click', function(e) {
            const toggleAllBtn = e.target.closest('.planner-toggle-all, .planner-expand-all');
            if (toggleAllBtn) {
                e.preventDefault();
                const detailsRows = Array.from(document.querySelectorAll('tr.planner-row-details[data-user-id]'));
                const anyCollapsed = detailsRows.some(function(r) {
                    return r.classList.contains('is-collapsed') || !r.classList.contains('is-expanded');
                });
                const willExpand = detailsRows.length === 0 || anyCollapsed;

                const states = getPlannerUserToggleStates();
                document.querySelectorAll('.planner-row[data-user-id]').forEach(function(r) {
                    r.classList.toggle('is-expanded', willExpand);
                    r.classList.toggle('is-collapsed', !willExpand);
                    const toggleBtn = r.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', willExpand ? 'true' : 'false');
                    }
                    const userId = r.getAttribute('data-user-id');
                    if (userId) {
                        states[userId] = willExpand;
                    }
                });
                try {
                    if (typeof KimaiStorage !== 'undefined') {
                        KimaiStorage.set('planner_user_toggle_states', states);
                    } else {
                        localStorage.setItem('planner_user_toggle_states', JSON.stringify(states));
                    }
                } catch (err) {
                    // ignore storage error
                }
                return;
            }

            const userCell = e.target.closest('.planner-user-cell');
            if (!userCell) {
                return;
            }

            if (e.target.closest('a')) {
                return;
            }

            e.preventDefault();

            const row = userCell.closest('tr');
            if (!row) {
                return;
            }

            const userId = row.getAttribute('data-user-id');
            const isExpanded = row.classList.contains('is-expanded');
            const willExpand = !isExpanded;

            if (userId) {
                document.querySelectorAll('.planner-row[data-user-id="' + userId + '"]').forEach(function(r) {
                    r.classList.toggle('is-expanded', willExpand);
                    r.classList.toggle('is-collapsed', !willExpand);
                    const toggleBtn = r.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', willExpand ? 'true' : 'false');
                    }
                });
                savePlannerUserToggleState(userId, willExpand);
            }
        });

        /*
         * Drag over empty day cells of one row to create a planned activity spanning several days.
         * A plain click (no drag) keeps opening the single-day dialog via the cell's link.
         */
        (function () {
            const CELL = 'td.day[data-planner-date]';
            let drag = null;
            let suppressClick = false;

            function cellsOf(row) {
                return Array.from(row.querySelectorAll(CELL));
            }

            function range(d) {
                return d.start <= d.current ? [d.start, d.current] : [d.current, d.start];
            }

            function paint(d) {
                const bounds = range(d);
                const selected = cellsOf(d.row).filter(function (cell) {
                    const date = cell.dataset.plannerDate;
                    const inRange = date >= bounds[0] && date <= bounds[1];
                    cell.classList.toggle('planner-drag-selected', inRange);
                    return inRange;
                });
                removePreview();
                if (selected.length < 2) {
                    return;
                }
                // one block spanning the selected cells, like a saved activity
                const first = selected[0].getBoundingClientRect();
                const last = selected[selected.length - 1].getBoundingClientRect();
                const pad = 4;
                const preview = document.createElement('div');
                preview.className = 'planner-drag-preview d-flex align-items-center px-2 py-1 rounded shadow-sm';
                preview.style.left = pad + 'px';
                preview.style.width = (last.right - first.left - 2 * pad) + 'px';
                selected[0].appendChild(preview);
            }

            function removePreview() {
                document.querySelectorAll('.planner-drag-preview').forEach(function (el) {
                    el.remove();
                });
            }

            function reset() {
                removePreview();
                document.querySelectorAll('.planner-drag-selected').forEach(function (cell) {
                    cell.classList.remove('planner-drag-selected');
                });
                document.body.classList.remove('planner-dragging');
                drag = null;
            }

            function openCreateDialog(d) {
                const table = d.row.closest('table[data-planner-create-url]');
                if (!table) {
                    return;
                }
                const bounds = range(d);
                const params = new URLSearchParams({user: d.row.dataset.userId, date: bounds[0], end: bounds[1]});
                if (d.row.dataset.customerId) {
                    params.set('customer', d.row.dataset.customerId);
                }
                if (d.row.dataset.projectId) {
                    params.set('project', d.row.dataset.projectId);
                }
                // reuse Kimai's delegated click handler for modal links
                const link = document.createElement('a');
                link.className = 'modal-ajax-form';
                link.href = table.dataset.plannerCreateUrl + '?' + params.toString();
                link.style.display = 'none';
                document.body.appendChild(link);
                link.click();
                link.remove();
            }

            document.addEventListener('mousedown', function (e) {
                if (e.button !== 0) {
                    return;
                }
                const cell = e.target.closest(CELL);
                if (!cell) {
                    return;
                }
                reset();
                drag = {row: cell.closest('tr'), start: cell.dataset.plannerDate, current: cell.dataset.plannerDate};
            });

            // the cell's stretched link would otherwise start a native link drag, which swallows mouseover and mouseup
            document.addEventListener('dragstart', function (e) {
                if (e.target.closest && e.target.closest(CELL)) {
                    e.preventDefault();
                }
            });

            document.addEventListener('mouseover', function (e) {
                if (drag === null) {
                    return;
                }
                const cell = e.target.closest(CELL);
                if (!cell || cell.closest('tr') !== drag.row || cell.dataset.plannerDate === drag.current) {
                    return;
                }
                drag.current = cell.dataset.plannerDate;
                if (drag.current !== drag.start) {
                    document.body.classList.add('planner-dragging');
                }
                paint(drag);
            });

            document.addEventListener('mouseup', function () {
                if (drag === null) {
                    return;
                }
                const finished = drag;
                reset();
                if (finished.start === finished.current) {
                    return;
                }
                openCreateDialog(finished);
                // keep the preview visible while the dialog is open
                paint(finished);
                // the click event following mouseup must not open the single-day dialog as well
                suppressClick = true;
                setTimeout(function () { suppressClick = false; }, 0);
            });

            document.addEventListener('click', function (e) {
                if (suppressClick) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            }, true);

            document.addEventListener('hidden.bs.modal', function () {
                if (drag === null) {
                    reset();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && drag !== null) {
                    reset();
                }
            });
        })();

        /*
         * Drag a planned activity to another day/row, or drag its left/right handle to extend or shorten it.
         * Only whole days are moved, the hours per day of the activity stay the same.
         * The pointer column is found through the day headers, because merged cells do not map to a single day.
         */
        (function () {
            const THRESHOLD = 4;
            let move = null;
            let suppressClick = false;

            function addDays(date, days) {
                const d = new Date(date + 'T00:00:00Z');
                d.setUTCDate(d.getUTCDate() + days);
                return d.toISOString().slice(0, 10);
            }

            function diffDays(a, b) {
                return Math.round((Date.parse(b + 'T00:00:00Z') - Date.parse(a + 'T00:00:00Z')) / 86400000);
            }

            function headerAt(x) {
                const headers = document.querySelectorAll('th[data-planner-day]');
                for (let i = 0; i < headers.length; i++) {
                    const r = headers[i].getBoundingClientRect();
                    if (x >= r.left && x < r.right) {
                        return headers[i];
                    }
                }
                return null;
            }

            function headerOf(date) {
                return document.querySelector('th[data-planner-day="' + date + '"]');
            }

            function rowAt(y) {
                const rows = document.querySelectorAll('tr.planner-row-details');
                for (let i = 0; i < rows.length; i++) {
                    const r = rows[i].getBoundingClientRect();
                    if (r.height > 0 && y >= r.top && y < r.bottom) {
                        return rows[i];
                    }
                }
                return null;
            }

            function removePreview() {
                document.querySelectorAll('.planner-move-preview').forEach(function (el) {
                    el.remove();
                });
            }

            function reset() {
                removePreview();
                document.body.classList.remove('planner-moving');
                move = null;
            }

            // new dates for the pointer position, null when the pointer is outside the day columns
            function target(m, x, y) {
                const header = headerAt(x);
                const row = rowAt(y);
                if (header === null || row === null) {
                    return null;
                }
                const delta = diffDays(m.grabbedDay, header.dataset.plannerDay);
                let begin = m.begin;
                let end = m.end;
                if (m.handle === 'start') {
                    begin = addDays(m.begin, delta);
                    if (begin > m.end) {
                        begin = m.end;
                    }
                } else if (m.handle === 'end') {
                    end = addDays(m.end, delta);
                    if (end < m.begin) {
                        end = m.begin;
                    }
                } else {
                    begin = addDays(m.begin, delta);
                    end = addDays(m.end, delta);
                }
                return {begin: begin, end: end, row: m.handle === null ? row : m.row};
            }

            function paint(m, t) {
                removePreview();
                if (t === null) {
                    return;
                }
                const first = headerOf(t.begin);
                const last = headerOf(t.end);
                if (first === null && last === null) {
                    return;
                }
                // a range reaching beyond the displayed weeks is cut at the edge of the grid
                const all = document.querySelectorAll('th[data-planner-day]');
                const rowRect = t.row.getBoundingClientRect();
                const left = (first || all[0]).getBoundingClientRect().left;
                const right = (last || all[all.length - 1]).getBoundingClientRect().right;
                const preview = document.createElement('div');
                preview.className = 'planner-move-preview';
                preview.style.left = left + 'px';
                preview.style.width = (right - left) + 'px';
                preview.style.top = (rowRect.top + 2) + 'px';
                preview.style.height = (rowRect.height - 4) + 'px';
                document.body.appendChild(preview);
            }

            function save(m, t) {
                const table = document.querySelector('table[data-planner-move-token]');
                const body = new URLSearchParams({_token: table.dataset.plannerMoveToken, begin: t.begin, end: t.end});
                if (t.row.dataset.userId !== m.row.dataset.userId) {
                    body.set('user', t.row.dataset.userId);
                }
                if (t.row.dataset.customerId && (t.row.dataset.customerId !== m.row.dataset.customerId || t.row.dataset.projectId !== m.row.dataset.projectId)) {
                    body.set('customer', t.row.dataset.customerId);
                    if (t.row.dataset.projectId) {
                        body.set('project', t.row.dataset.projectId);
                    }
                }
                fetch(m.url, {method: 'POST', body: body, headers: {'X-Requested-With': 'XMLHttpRequest'}})
                    .then(function (response) {
                        if (response.ok) {
                            document.dispatchEvent(new CustomEvent('kimai.plannerActivityUpdate'));
                            return null;
                        }
                        return response.json().catch(function () { return {}; }).then(function (data) {
                            const message = response.status === 422 && data.message ? data.message : table.dataset.plannerMoveError;
                            if (window.kimai) {
                                window.kimai.getPlugin('alert').error(message);
                            } else {
                                window.alert(message);
                            }
                        });
                    })
                    .catch(function () {
                        window.alert(table.dataset.plannerMoveError);
                    });
            }

            document.addEventListener('mousedown', function (e) {
                if (e.button !== 0) {
                    return;
                }
                const activity = e.target.closest('.planner-activity[data-planner-move-url]');
                const header = headerAt(e.clientX);
                if (!activity || header === null) {
                    return;
                }
                const handle = e.target.closest('[data-planner-handle]');
                move = {
                    url: activity.dataset.plannerMoveUrl,
                    begin: activity.dataset.plannerBegin,
                    end: activity.dataset.plannerEnd,
                    handle: handle ? handle.dataset.plannerHandle : null,
                    row: activity.closest('tr'),
                    grabbedDay: header.dataset.plannerDay,
                    startX: e.clientX,
                    startY: e.clientY,
                    active: false,
                    target: null
                };
            });

            // the activity is a link, a native link drag would swallow mousemove and mouseup
            document.addEventListener('dragstart', function (e) {
                if (e.target.closest && e.target.closest('.planner-movable')) {
                    e.preventDefault();
                }
            });

            document.addEventListener('mousemove', function (e) {
                if (move === null) {
                    return;
                }
                if (!move.active) {
                    if (Math.abs(e.clientX - move.startX) < THRESHOLD && Math.abs(e.clientY - move.startY) < THRESHOLD) {
                        return;
                    }
                    move.active = true;
                    document.body.classList.add('planner-moving');
                }
                move.target = target(move, e.clientX, e.clientY);
                paint(move, move.target);
            });

            document.addEventListener('mouseup', function () {
                if (move === null) {
                    return;
                }
                const finished = move;
                reset();
                if (!finished.active) {
                    return;
                }
                // the click following mouseup must not open the edit dialog
                suppressClick = true;
                setTimeout(function () { suppressClick = false; }, 0);

                const t = finished.target;
                if (t === null || (t.begin === finished.begin && t.end === finished.end && t.row === finished.row)) {
                    return;
                }
                save(finished, t);
            });

            document.addEventListener('click', function (e) {
                if (suppressClick) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            }, true);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && move !== null) {
                    reset();
                }
            });
        })();
    </script>
{% endblock %}
