{% extends 'page_setup.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block page_class %}planner-page{% endblock %}

{% block main %}
    <div class="page-header d-print-none">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col">
                    <div class="btn-group week-picker-btn-group" role="group" aria-label="{{ 'planner.title'|trans }}">
                        <a href="{{ path('planner_week', {'date': prevWeek}) }}" class="btn btn-left btn-icon">
                            {{ icon('left') }}
                        </a>
                        <span class="btn btn-default pe-none">
                            {{ currentWeek|month_name(true) }}
                            -
                            {{ 'stats.workingTimeWeekShort'|trans({'%week%': currentWeek|date('W')}) }}
                            {% if weeks > 1 %}
                                {% set lastWeek = currentWeek.modify('+' ~ (weeks - 1) ~ ' week') %}
                                &ndash; {{ 'stats.workingTimeWeekShort'|trans({'%week%': lastWeek|date('W')}) }}
                            {% endif %}
                        </span>
                        <a href="{{ path('planner_week', {'date': nextWeek}) }}" class="btn btn-right btn-icon">
                            {{ icon('right') }}
                        </a>
                    </div>
                    <a href="{{ path('planner_week', {'date': todayWeek}) }}" class="btn">
                        {{ icon('calendar', true) }}
                        {{ 'planner.this_week'|trans }}
                    </a>
                    <div class="btn-group" role="group" aria-label="{{ 'planner.weeks'|trans }}" title="{{ 'planner.weeks'|trans }}">
                        {% for option in weekOptions %}
                            <a href="{{ path('planner_week', {'date': currentWeek|date('Y-m-d'), 'weeks': option}) }}" class="btn{% if option == weeks %} active{% endif %}">{{ 'planner.weeks_option'|trans({'%count%': option}) }}</a>
                        {% endfor %}
                    </div>
                    <button type="button" class="btn planner-toggle-all planner-expand-all">
                        {{ icon('fas fa-plus-minus', true) }}
                        {{ 'planner.toggle_all'|trans }}
                    </button>
                </div>

                {% if canCreate %}
                <div class="col-auto ms-auto d-print-none">
                    <div class="page-actions">
                        {{ widgets.card_tool_button('create', {
                            'class': 'modal-ajax-form',
                            'title': 'planner.planned_activity',
                            'combined': true,
                            'url': path('planner_activity_create', {
                                'date': currentWeek|date('Y-m-d')
                            })
                        }) }}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-fluid">
            <section class="content">
                <div class="card mt-2 mb-3">
                    <div class="card-body p-0">
                        <table class="table table-hover dataTable"{% if canCreate %} data-planner-create-url="{{ path('planner_activity_create') }}"{% endif %}>
                            <colgroup>
                                <col span="2">
                                {% for day in plannerData.dateHeaders %}
                                    <col{% if day is today %} class="today"{% endif %}>
                                {% endfor %}
                            </colgroup>
                            <thead class="sticky-top">
                                {% set compact = weeks > 1 %}
                                {% if compact %}
                                    <tr>
                                        <th class="border-bottom p-1" colspan="2"></th>
                                        {% for week in plannerData.dateHeaders|batch(7) %}
                                            <th class="text-center border-bottom border-start p-1" colspan="7">
                                                {% set weekStart = week|first %}
                                                {% set weekEnd = week|last %}
                                                <span class="badge bg-blue-lt me-1">{{ 'planner.week_header'|trans({'%week%': weekStart|date('W')}) }}</span>
                                                <span class="text-muted fw-normal">
                                                    {%- if weekStart|date('n') == weekEnd|date('n') -%}
                                                        {{ weekStart|date('j') }}-{{ weekEnd|date('j') }} {{ weekEnd|month_name|slice(0, 3)|lower }}
                                                    {%- else -%}
                                                        {{ weekStart|date('j') }} {{ weekStart|month_name|slice(0, 3)|lower }} - {{ weekEnd|date('j') }} {{ weekEnd|month_name|slice(0, 3)|lower }}
                                                    {%- endif -%}
                                                </span>
                                            </th>
                                        {% endfor %}
                                    </tr>
                                {% endif %}
                                <tr>
                                    <th class="w-avatar border-bottom p-1" colspan="2"></th>
                                    {% for day in plannerData.dateHeaders %}
                                        <th class="text-center border-bottom{% if loop.index0 % 7 == 0 %} border-start{% endif %}{% if day is weekend %} weekend{% endif %}{% if day is today %} today{% endif %} p-1" style="min-width: {{ compact ? 44 : 110 }}px;">
                                            {{ day|date('j') }}
                                        </th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in plannerData.rows %}
                                    <tr class="planner-row planner-row-summary is-collapsed" data-user-id="{{ row.user.id }}">
                                        <td class="w-avatar align-middle p-1 planner-user-cell">{{ widgets.user_avatar(row.user, false, 'avatar-sm') }}</td>
                                        <td class="text-nowrap align-middle p-1 planner-user-cell">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>{{ row.user.displayName }}</div>
                                                <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary planner-user-toggle m-2 p-0" aria-expanded="false" title="{{ 'planner.toggle_activities'|trans }}">
                                                    <span class="toggle-icon d-inline-block">{{ icon('right') }}</span>
                                                </button>
                                            </div>
                                        </td>
                                        {% for week in row.weeks %}
                                            {% set barColorClass = week.isOverAllocated ? 'planner-bar-danger' : (week.totalPlannedHours > 0 ? 'planner-bar-success' : 'planner-bar-muted') %}
                                            <td colspan="{{ week.days|length }}" class="planner-week-summary align-middle p-0{% if compact %} border-start{% endif %}">
                                                <div class="planner-summary-bar {{ barColorClass }}">
                                                    <div class="planner-summary-badge">
                                                        <div class="planner-summary-pct">{{ week.plannedPercentage }}%</div>
                                                        <div class="planner-summary-hours">
                                                            {{ week.totalPlannedHours }}/{{ week.totalExpectedHours }} hrs ({{ week.totalActualHours }} hrs)
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    {% set groups = row.groups %}
                                    {% for group in groups %}
                                        <tr class="planner-row planner-row-details is-collapsed" data-user-id="{{ row.user.id }}"{% if group.customer %} data-customer-id="{{ group.customer.id }}"{% endif %}{% if group.project %} data-project-id="{{ group.project.id }}"{% endif %}>
                                            <td class="planner-group-cell p-1 border-top-0" colspan="2">
                                                <div class="d-flex justify-content-between align-items-center planner-group-label" title="{{ group.customerName }}{% if group.projectName %} / {{ group.projectName }}{% endif %}">
                                                    <div class="text-truncate">
                                                        <span class="fw-bold small">{{ group.customerName }}</span>{% if group.projectName %}<span class="text-muted small"> / {{ group.projectName }}</span>{% endif %}
                                                    </div>
                                                    <span class="text-muted small ms-2 flex-shrink-0">{{ group.getPlannedHours(row.days) }}h</span>
                                                </div>
                                            </td>
                                            {% for segment in group.getSegments(row.days) %}
                                                {% set date = segment.date %}
                                                <td colspan="{{ segment.span }}" class="position-relative align-middle border-1 day{% if date is weekend %} weekend{% endif %}{% if date is today %} today{% endif %} p-1 {{ segment.activities is not empty ? 'has-activities' : 'no-activities' }}"{% if canCreate and segment.activities is empty %} data-planner-date="{{ date|date('Y-m-d') }}"{% endif %}>
                                                    {% if canCreate and segment.activities is empty %}
                                                        <a href="{{ path('planner_activity_create', {'user': row.user.id, 'date': date|date('Y-m-d')}) }}"
                                                           class="stretched-link cursor-crosshair modal-ajax-form"
                                                           title="{{ 'planner.planned_activity'|trans }}"></a>
                                                    {% endif %}
                                                    {% for activity in segment.activities %}
                                                        <a href="{{ path('planner_activity_edit', {'id': activity.id, 'date': date|date('Y-m-d')}) }}"
                                                           class="planner-activity position-relative z-2 d-flex justify-content-between align-items-center px-2 py-1 rounded text-decoration-none modal-ajax-form shadow-sm{% if not loop.first %} mt-1{% endif %}"
                                                           style="background-color: {{ activity.colorSafe }}; color: {{ activity.colorSafe|font_contrast }};"
                                                           title="{{ activity.name }} ({{ activity.hoursPerDay }}h){% if activity.hasComment %}: {{ activity.comment|u.truncate(1024, '...') }}{% endif %}">
                                                            <span class="text-truncate small">{% if activity.hasComment %}{{ icon('comment') }} {% endif %}{{ activity.hoursPerDay }}h</span>
                                                        </a>
                                                    {% endfor %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                    {# always keep one empty row per user, so new planning can be dragged out #}
                                    <tr class="planner-row planner-row-details is-collapsed" data-user-id="{{ row.user.id }}">
                                        <td colspan="2" class="planner-group-cell p-1 border-top-0"></td>
                                        {% for day in row.days %}
                                            <td class="position-relative border-1 day{% if day.date is weekend %} weekend{% endif %}{% if day.date is today %} today{% endif %} p-1 no-activities"{% if canCreate %} data-planner-date="{{ day.date|date('Y-m-d') }}"{% endif %}>
                                                {% if canCreate %}
                                                    <a href="{{ path('planner_activity_create', {'user': row.user.id, 'date': day.date|date('Y-m-d')}) }}"
                                                       class="stretched-link cursor-crosshair modal-ajax-form"
                                                       title="{{ 'planner.planned_activity'|trans }}"></a>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="10" class="text-center text-muted p-1">
                                            {{ 'error.no_entries_found'|trans }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            {% if plannerData.rows|length > 0 %}
                                <tfoot>
                                    <tr class="bg-light fw-bold">
                                        <td class="text-right p-1" colspan="2">
                                            <div>{{ plannerData.totalPlannedHours }}h / {{ plannerData.totalExpectedHours }}h</div>
                                            {% if plannerData.totalActualHours > 0 %}
                                                <div class="small text-muted fw-normal">{{ 'planner.actual_hours'|trans }}: {{ plannerData.totalActualHours }}h</div>
                                            {% endif %}
                                        </td>
                                        {% for day in plannerData.dateHeaders %}
                                            {% set dayTotalPlanned = plannerData.getTotalPlannedHoursForDay(day) %}
                                            {% set dayTotalActual = plannerData.getTotalActualHoursForDay(day) %}
                                            <td class="align-top text-center{% if day is today %} today{% endif %} p-1">
                                                <div>{{ dayTotalPlanned }}h</div>
                                                {% if dayTotalActual > 0 %}
                                                    <div class="small text-muted fw-normal">{{ dayTotalActual }}h</div>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                </tfoot>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        td.day {
            height: 36px;
        }
        tr.planner-row-details td.day {
            height: 32px;
        }
        td.day[data-planner-date] {
            user-select: none;
        }
        td.day.planner-drag-selected,
        td.day.planner-drag-selected:hover {
            background-color: rgba(32, 107, 196, 0.35) !important;
            outline: 2px solid #206bc4;
            outline-offset: -2px;
        }
        body.planner-dragging {
            cursor: crosshair;
            user-select: none;
        }
        .planner-group-label {
            padding-left: 2.5rem;
            max-width: 18rem;
        }
        col.today {
            background-color: var(--tblr-highlight-bg);
        }
        table.dataTable tbody td.today,
        table.dataTable tfoot td.today {
            background-color: var(--tblr-highlight-bg) !important;
        }
        table.dataTable tbody td.today:hover {
            background-color: #ccc !important;
        }
        td.day:hover {
            background-color: #ccc;
        }
        .planner-activity {
            min-width: 100%;
        }
        td.planner-week-summary {
            padding: 0 !important;
            vertical-align: middle;
        }
        .planner-summary-bar {
            width: 100%;
            height: 100%;
            min-height: 48px;
            display: flex;
            align-items: stretch;
        }
        .planner-bar-success {
            background-color: #5fa675;
        }
        .planner-bar-danger {
            background-color: #db5c5c;
        }
        .planner-bar-muted {
            background-color: #94a3b8;
        }
        .planner-summary-badge {
            background-color: rgba(0, 0, 0, 0.35);
            color: #ffffff;
            padding: 4px 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 140px;
            flex-shrink: 0;
        }
        .planner-summary-pct {
            font-weight: 700;
            font-size: 1.1rem;
            line-height: 1.2;
        }
        .planner-summary-hours {
            font-size: 0.8rem;
            line-height: 1.2;
            white-space: nowrap;
            color: rgba(255, 255, 255, 0.95);
        }
        .planner-user-cell {
            cursor: pointer;
            user-select: none;
        }
        .planner-user-toggle {
            line-height: 1;
        }
        .planner-user-toggle .toggle-icon {
            transition: transform 0.15s ease-in-out;
        }
        .planner-user-toggle[aria-expanded="true"] .toggle-icon,
        tr.is-expanded .planner-user-toggle .toggle-icon {
            transform: rotate(90deg);
        }
        tr.planner-row-summary {
            display: table-row;
        }
        tr.planner-row-details.is-collapsed {
            display: none;
        }
        tr.planner-row-details.is-expanded {
            display: table-row;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        function getPlannerUserToggleStates() {
            try {
                if (typeof KimaiStorage !== 'undefined') {
                    return KimaiStorage.get('planner_user_toggle_states') || {};
                }
                const data = localStorage.getItem('planner_user_toggle_states');
                return data ? JSON.parse(data) : {};
            } catch (e) {
                return {};
            }
        }

        function savePlannerUserToggleState(userId, isExpanded) {
            try {
                const states = getPlannerUserToggleStates();
                states[userId] = isExpanded;
                if (typeof KimaiStorage !== 'undefined') {
                    KimaiStorage.set('planner_user_toggle_states', states);
                } else {
                    localStorage.setItem('planner_user_toggle_states', JSON.stringify(states));
                }
            } catch (e) {
                // ignore storage error
            }
        }

        function restorePlannerUserToggleStates() {
            const states = getPlannerUserToggleStates();
            document.querySelectorAll('.planner-row[data-user-id]').forEach(function(row) {
                const userId = row.getAttribute('data-user-id');
                if (userId && states[userId] !== undefined) {
                    const isExpanded = !!states[userId];
                    row.classList.toggle('is-expanded', isExpanded);
                    row.classList.toggle('is-collapsed', !isExpanded);
                    const toggleBtn = row.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                    }
                }
            });
        }

        document.addEventListener('kimai.initialized', function() {
            // Soft reload (reloads content area without full browser refresh)
            KimaiReloadPageWidget.create('kimai.plannerActivityUpdate');
            restorePlannerUserToggleStates();
        });

        document.addEventListener('kimai.reloadPage', function() {
            restorePlannerUserToggleStates();
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', restorePlannerUserToggleStates);
        } else {
            restorePlannerUserToggleStates();
        }

        document.addEventListener('click', function(e) {
            const toggleAllBtn = e.target.closest('.planner-toggle-all, .planner-expand-all');
            if (toggleAllBtn) {
                e.preventDefault();
                const detailsRows = Array.from(document.querySelectorAll('tr.planner-row-details[data-user-id]'));
                const anyCollapsed = detailsRows.some(function(r) {
                    return r.classList.contains('is-collapsed') || !r.classList.contains('is-expanded');
                });
                const willExpand = detailsRows.length === 0 || anyCollapsed;

                const states = getPlannerUserToggleStates();
                document.querySelectorAll('.planner-row[data-user-id]').forEach(function(r) {
                    r.classList.toggle('is-expanded', willExpand);
                    r.classList.toggle('is-collapsed', !willExpand);
                    const toggleBtn = r.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', willExpand ? 'true' : 'false');
                    }
                    const userId = r.getAttribute('data-user-id');
                    if (userId) {
                        states[userId] = willExpand;
                    }
                });
                try {
                    if (typeof KimaiStorage !== 'undefined') {
                        KimaiStorage.set('planner_user_toggle_states', states);
                    } else {
                        localStorage.setItem('planner_user_toggle_states', JSON.stringify(states));
                    }
                } catch (err) {
                    // ignore storage error
                }
                return;
            }

            const userCell = e.target.closest('.planner-user-cell');
            if (!userCell) {
                return;
            }

            if (e.target.closest('a')) {
                return;
            }

            e.preventDefault();

            const row = userCell.closest('tr');
            if (!row) {
                return;
            }

            const userId = row.getAttribute('data-user-id');
            const isExpanded = row.classList.contains('is-expanded');
            const willExpand = !isExpanded;

            if (userId) {
                document.querySelectorAll('.planner-row[data-user-id="' + userId + '"]').forEach(function(r) {
                    r.classList.toggle('is-expanded', willExpand);
                    r.classList.toggle('is-collapsed', !willExpand);
                    const toggleBtn = r.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', willExpand ? 'true' : 'false');
                    }
                });
                savePlannerUserToggleState(userId, willExpand);
            }
        });

        /*
         * Drag over empty day cells of one row to create a planned activity spanning several days.
         * A plain click (no drag) keeps opening the single-day dialog via the cell's link.
         */
        (function () {
            const CELL = 'td.day[data-planner-date]';
            let drag = null;
            let suppressClick = false;

            function cellsOf(row) {
                return Array.from(row.querySelectorAll(CELL));
            }

            function range(d) {
                return d.start <= d.current ? [d.start, d.current] : [d.current, d.start];
            }

            function paint(d) {
                const bounds = range(d);
                cellsOf(d.row).forEach(function (cell) {
                    const date = cell.dataset.plannerDate;
                    cell.classList.toggle('planner-drag-selected', date >= bounds[0] && date <= bounds[1]);
                });
            }

            function reset() {
                document.querySelectorAll('.planner-drag-selected').forEach(function (cell) {
                    cell.classList.remove('planner-drag-selected');
                });
                document.body.classList.remove('planner-dragging');
                drag = null;
            }

            function openCreateDialog(d) {
                const table = d.row.closest('table[data-planner-create-url]');
                if (!table) {
                    return;
                }
                const bounds = range(d);
                const params = new URLSearchParams({user: d.row.dataset.userId, date: bounds[0], end: bounds[1]});
                if (d.row.dataset.customerId) {
                    params.set('customer', d.row.dataset.customerId);
                }
                if (d.row.dataset.projectId) {
                    params.set('project', d.row.dataset.projectId);
                }
                // reuse Kimai's delegated click handler for modal links
                const link = document.createElement('a');
                link.className = 'modal-ajax-form';
                link.href = table.dataset.plannerCreateUrl + '?' + params.toString();
                link.style.display = 'none';
                document.body.appendChild(link);
                link.click();
                link.remove();
            }

            document.addEventListener('mousedown', function (e) {
                if (e.button !== 0) {
                    return;
                }
                const cell = e.target.closest(CELL);
                if (!cell) {
                    return;
                }
                drag = {row: cell.closest('tr'), start: cell.dataset.plannerDate, current: cell.dataset.plannerDate};
            });

            document.addEventListener('mouseover', function (e) {
                if (drag === null) {
                    return;
                }
                const cell = e.target.closest(CELL);
                if (!cell || cell.closest('tr') !== drag.row || cell.dataset.plannerDate === drag.current) {
                    return;
                }
                drag.current = cell.dataset.plannerDate;
                if (drag.current !== drag.start) {
                    document.body.classList.add('planner-dragging');
                }
                paint(drag);
            });

            document.addEventListener('mouseup', function () {
                if (drag === null) {
                    return;
                }
                const finished = drag;
                reset();
                if (finished.start === finished.current) {
                    return;
                }
                openCreateDialog(finished);
                // the click event following mouseup must not open the single-day dialog as well
                suppressClick = true;
                setTimeout(function () { suppressClick = false; }, 0);
            });

            document.addEventListener('click', function (e) {
                if (suppressClick) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            }, true);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && drag !== null) {
                    reset();
                }
            });
        })();
    </script>
{% endblock %}
