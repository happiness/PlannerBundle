{% extends 'page_setup.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block page_class %}planner-page{% endblock %}

{% block main %}
    <div class="page-header d-print-none">
        <div class="container-fluid">
            {# a row of its own, the navigation row below is already full #}
            {% if is_granted('calendar_feed_planner') %}
                <div class="row mb-2">
                    <div class="col-auto ms-auto">
                        <a href="{{ path('planner_calendar') }}" class="btn" title="{{ 'planner.calendar.intro'|trans }}">
                            {{ icon('calendar', true) }}
                            {{ 'planner.calendar.button'|trans }}
                        </a>
                    </div>
                </div>
            {% endif %}
            <div class="row align-items-center">
                <div class="col">
                    <div class="btn-group week-picker-btn-group" role="group" aria-label="{{ 'planner.title'|trans }}">
                        {# with one week shown, a period is a week and the single arrows already do it #}
                        {% if weeks > 1 %}
                            {% set periodLabel = 'planner.previous_period'|trans({'%count%': weeks}) %}
                            <a href="{{ path('planner_week', {'date': prevPeriod}) }}" class="btn btn-icon" data-toggle="tooltip" data-placement="top" title="{{ periodLabel }}" aria-label="{{ periodLabel }}">
                                {{ icon('left2') }}
                            </a>
                        {% endif %}
                        <a href="{{ path('planner_week', {'date': prevWeek}) }}" class="btn btn-left btn-icon" data-toggle="tooltip" data-placement="top" title="{{ 'planner.previous_week'|trans }}" aria-label="{{ 'planner.previous_week'|trans }}">
                            {{ icon('left') }}
                        </a>
                        <span class="btn btn-default pe-none">
                            {{ currentWeek|month_name(true) }}
                            -
                            {{ 'stats.workingTimeWeekShort'|trans({'%week%': currentWeek|date('W')}) }}
                            {% if weeks > 1 %}
                                {% set lastWeek = currentWeek.modify('+' ~ (weeks - 1) ~ ' week') %}
                                &ndash; {{ 'stats.workingTimeWeekShort'|trans({'%week%': lastWeek|date('W')}) }}
                            {% endif %}
                        </span>
                        <a href="{{ path('planner_week', {'date': nextWeek}) }}" class="btn btn-right btn-icon" data-toggle="tooltip" data-placement="top" title="{{ 'planner.next_week'|trans }}" aria-label="{{ 'planner.next_week'|trans }}">
                            {{ icon('right') }}
                        </a>
                        {% if weeks > 1 %}
                            {% set periodLabel = 'planner.next_period'|trans({'%count%': weeks}) %}
                            <a href="{{ path('planner_week', {'date': nextPeriod}) }}" class="btn btn-icon" data-toggle="tooltip" data-placement="top" title="{{ periodLabel }}" aria-label="{{ periodLabel }}">
                                {{ icon('right2') }}
                            </a>
                        {% endif %}
                    </div>
                    <a href="{{ path('planner_week', {'date': todayWeek}) }}" class="btn">
                        {{ icon('calendar', true) }}
                        {{ 'planner.this_week'|trans }}
                    </a>
                    <div class="btn-group" role="group" aria-label="{{ 'planner.weeks'|trans }}" title="{{ 'planner.weeks'|trans }}">
                        {% for option in weekOptions %}
                            <a href="{{ path('planner_week', {'date': currentWeek|date('Y-m-d'), 'weeks': option}) }}" class="btn{% if option == weeks %} active{% endif %}">{{ 'planner.weeks_option'|trans({'%count%': option}) }}</a>
                        {% endfor %}
                    </div>
                    <button type="button" class="btn planner-toggle-all planner-expand-all">
                        {{ icon('fas fa-plus-minus', true) }}
                        {{ 'planner.toggle_all'|trans }}
                    </button>
                </div>

                <div class="col-auto ms-auto d-print-none d-flex gap-2 align-items-center">
                    {% if toolbarForm is defined and toolbarForm is not null %}
                        {% form_theme toolbarForm 'form/search.html.twig' %}
                        {{ form_start(toolbarForm, {'attr': {'class': 'searchform d-flex align-items-center'}}) }}
                        {% set filterCount = query.countFilter() %}
                        <div class="input-group inline-search position-static">
                            <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="false" aria-haspopup="true" aria-expanded="false" id="search-dropdown-btn" title="{{ 'search_filter'|trans }}">
                                {{ icon('filter', true) }}
                                {% if filterCount > 0 %}<span class="badge badge-notification bg-primary text-primary-fg ms-1 d-none d-sm-inline">{{ filterCount }}</span>{% endif %}
                            </button>
                            <div class="dropdown-menu p-3 search-dropdown" data-popper-placement="bottom-start" aria-labelledby="search-dropdown-btn">
                                {{ form_rest(toolbarForm) }}
                                <div class="row mt-3">
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-primary">{{ 'search'|trans }}</button>
                                    </div>
                                </div>
                            </div>
                            <span class="input-group-text">
                                {% set bookmarkToken = csrf_token('search') %}
                                {% set searchBtnClass = 'btn btn-icon btn-sm btn-ghost-secondary p-1' %}
                                <input type="hidden" name="_token" value="{{ bookmarkToken }}">
                                <button type="submit" class="{{ searchBtnClass }}" data-toggle="tooltip" title="{{ 'search'|trans }}">
                                    {{ icon('search') }}
                                </button>

                                {% if toolbarForm.vars.data.bookmark %}
                                <a class="{{ searchBtnClass }} text-yellow" href="?_token={{ bookmarkToken }}&removeDefaultQuery={{ toolbarForm.vars.data.bookmark.name }}" data-toggle="tooltip" title="{{ 'remove_default'|trans }}" id="removeDefaultQuery">
                                    {{ icon('bookmarked') }}
                                </a>
                                {% elseif filterCount > 0 %}
                                <button class="{{ searchBtnClass }}" type="submit" id="setDefaultQuery" name="setDefaultQuery" data-toggle="tooltip" title="{{ 'set_as_default'|trans }}">
                                    {{ icon('bookmark') }}
                                </button>
                                {% endif %}

                                {% if filterCount > 0 and not toolbarForm.vars.data.isBookmarkSearch() %}
                                    <a class="{{ searchBtnClass }} text-orange" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}" data-toggle="tooltip" title="{{ 'remove_filter'|trans }}">
                                        {{ icon('cancel') }}
                                    </a>
                                {% endif %}
                            </span>
                        </div>
                        <input type="hidden" name="performSearch" value="performSearch" />
                        {{ form_end(toolbarForm) }}
                    {% endif %}

                    {% if canCreate %}
                    <div class="page-actions">
                        {{ widgets.card_tool_button('create', {
                            'class': 'modal-ajax-form',
                            'title': 'planner.planned_activity',
                            'combined': true,
                            'url': path('planner_activity_create', {
                                'date': currentWeek|date('Y-m-d')
                            })
                        }) }}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-fluid">
            <section class="content">
                <div class="card mt-2 mb-3">
                    <div class="card-body p-0">
                        <table class="table table-hover dataTable" data-planner-move-token="{{ csrf_token('planner_move') }}" data-planner-move-error="{{ 'planner.move_error'|trans }}" data-planner-split-title="{{ 'planner.split_here'|trans }}" data-planner-join-title="{{ 'planner.join_here'|trans }}"{% if canCreate %} data-planner-create-url="{{ path('planner_activity_create') }}" data-planner-day-off-question="{{ 'planner.day_off_question'|trans }}" data-planner-days-off-question="{{ 'planner.days_off_question'|trans }}"{% endif %}>
                            <colgroup>
                                <col span="2">
                                {% for day in plannerData.dateHeaders %}
                                    <col{% if day is today %} class="today"{% endif %}>
                                {% endfor %}
                            </colgroup>
                            <thead class="sticky-top">
                                {% set compact = weeks > 1 %}
                                {% if compact %}
                                    <tr>
                                        <th class="border-bottom p-1" colspan="2"></th>
                                        {% for week in plannerData.dateHeaders|batch(7) %}
                                            <th class="text-center border-bottom border-start p-1" colspan="7">
                                                {% set weekStart = week|first %}
                                                {% set weekEnd = week|last %}
                                                <span class="badge bg-blue-lt me-1">{{ 'planner.week_header'|trans({'%week%': weekStart|date('W')}) }}</span>
                                                <span class="text-muted fw-normal">
                                                    {%- if weekStart|date('n') == weekEnd|date('n') -%}
                                                        {{ weekStart|date('j') }}-{{ weekEnd|date('j') }} {{ weekEnd|month_name|slice(0, 3)|lower }}
                                                    {%- else -%}
                                                        {{ weekStart|date('j') }} {{ weekStart|month_name|slice(0, 3)|lower }} - {{ weekEnd|date('j') }} {{ weekEnd|month_name|slice(0, 3)|lower }}
                                                    {%- endif -%}
                                                </span>
                                            </th>
                                        {% endfor %}
                                    </tr>
                                {% endif %}
                                <tr>
                                    <th class="w-avatar border-bottom p-1" colspan="2"></th>
                                    {% for day in plannerData.dateHeaders %}
                                        <th data-planner-day="{{ day|date('Y-m-d') }}" class="text-center border-bottom{% if loop.index0 % 7 == 0 %} border-start{% endif %}{% if day is weekend %} weekend{% endif %}{% if day is today %} today{% endif %} p-1" style="min-width: {{ compact ? 44 : 110 }}px;">
                                            {{ day|date('j') }}
                                        </th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in plannerData.rows %}
                                    {# rows of users you may only look at offer no new planning #}
                                    {% set canCreateRow = canCreate and row.user.id in creatableUsers %}
                                    {# without a work contract every day counts as a day off, so nothing is worth confirming #}
                                    {% set confirmDaysOff = row.days|filter(day => day.workingDay) is not empty %}
                                    <tr class="planner-row planner-row-summary is-collapsed" data-user-id="{{ row.user.id }}" data-planner-user-name="{{ row.user.displayName }}">
                                        <td class="w-avatar align-middle p-1 planner-user-cell">{{ widgets.user_avatar(row.user, false, 'avatar-sm') }}</td>
                                        <td class="text-nowrap align-middle p-1 planner-user-cell">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <div>{{ row.user.displayName }}</div>
                                                    {# explains the order while sorting by free hours #}
                                                    {% if query.orderedByFreeHours %}
                                                        {% set freeHours = row.freeHours %}
                                                        <div class="small {{ freeHours < 0 ? 'text-danger' : 'text-muted' }} planner-free-hours">{{ (freeHours < 0 ? 'planner.over_hours' : 'planner.free_hours')|trans({'%hours%': freeHours|abs}) }}</div>
                                                    {% endif %}
                                                </div>
                                                <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary planner-user-toggle m-2 p-0" aria-expanded="false" title="{{ 'planner.toggle_activities'|trans }}">
                                                    <span class="toggle-icon d-inline-block">{{ icon('right') }}</span>
                                                </button>
                                            </div>
                                        </td>
                                        {% for week in row.weeks %}
                                            {# amber with space left, green when full, red when overbooked, like the day cells below #}
                                            {% if week.isOverAllocated %}
                                                {% set barColorClass = 'planner-bar-danger' %}
                                            {% elseif week.totalPlannedHours > 0 and week.isBalanced %}
                                                {% set barColorClass = 'planner-bar-success' %}
                                            {% elseif week.totalPlannedHours > 0 %}
                                                {% set barColorClass = 'planner-bar-warning' %}
                                            {% else %}
                                                {% set barColorClass = 'planner-bar-muted' %}
                                            {% endif %}
                                            <td colspan="{{ week.days|length }}" class="planner-week-summary align-middle p-0{% if compact %} border-start{% endif %}">
                                                <div class="planner-summary-bar {{ barColorClass }}">
                                                    <div class="planner-summary-badge">
                                                        <div class="planner-summary-pct">{{ week.plannedPercentage }}%</div>
                                                        <div class="planner-summary-hours">
                                                            {{ 'planner.week_hours'|trans({'%planned%': week.totalPlannedHours, '%expected%': week.totalCapacityHours, '%actual%': week.totalActualHours}) }}
                                                        </div>
                                                    </div>
                                                    {# tentative work on top of the confirmed planning, it does not change the colour #}
                                                    {% if week.totalTentativeHours > 0 %}
                                                        <div class="planner-summary-tentative" style="flex-basis: {{ min(week.tentativePercentage, 100) }}%;" title="{{ 'planner.tentative_hours'|trans({'%hours%': week.totalTentativeHours}) }}">
                                                            <span class="text-truncate">{{ 'planner.tentative_hours'|trans({'%hours%': week.totalTentativeHours}) }}</span>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    {% set holidays = {} %}
                                    {% for day in row.days|filter(day => day.holiday) %}
                                        {% set holidays = holidays|merge({(day.date|date('Y-m-d')): day.holiday}) %}
                                    {% endfor %}
                                    {# planned against contract hours minus time off per day, aligned with the day columns and always visible #}
                                    <tr class="planner-row-days">
                                        <td colspan="2" class="p-0 border-top-0"></td>
                                        {% for day in row.days %}
                                            {# the cell fills up to the planned share of the day: amber with space left, green when full, red when overbooked #}
                                            {% if day.isDayOff and day.plannedHours == 0 %}
                                                {% set dayClass = 'planner-day-off' %}
                                                {% set dayFill = 0 %}
                                            {% elseif day.isOverAllocated %}
                                                {% set dayClass = 'planner-day-danger' %}
                                                {% set dayFill = 100 %}
                                            {% elseif day.plannedHours > 0 and day.isBalanced %}
                                                {% set dayClass = 'planner-day-success' %}
                                                {% set dayFill = 100 %}
                                            {% elseif day.plannedHours > 0 %}
                                                {% set dayClass = 'planner-day-warning' %}
                                                {% set dayFill = day.plannedPercentage %}
                                            {% else %}
                                                {% set dayClass = 'planner-day-muted' %}
                                                {% set dayFill = 0 %}
                                            {% endif %}
                                            {% set dayHours = 'planner.day_hours'|trans({'%planned%': day.plannedHours, '%expected%': day.capacityHours, '%actual%': day.actualHours}) %}
                                            {% if day.timeOffHours > 0 %}
                                                {% set dayHours = dayHours ~ ', ' ~ 'planner.day_time_off'|trans({'%hours%': day.timeOffHours}) %}
                                            {% endif %}
                                            {% if day.holiday %}
                                                {% set dayHours = day.holiday.name ~ ' (' ~ day.holiday.calendarName ~ ')' ~ (day.plannedHours > 0 ? ', ' ~ dayHours : '') %}
                                            {% endif %}
                                            <td class="planner-day-summary text-center border-top-0 {{ dayClass }}{% if day.holiday %} planner-holiday{% endif %}{% if loop.index0 % 7 == 0 %} border-start{% endif %}{% if day.date is weekend %} weekend{% endif %}{% if day.date is today %} today{% endif %}" style="--planner-day-fill: {{ dayFill }}%;" title="{{ dayHours }}"{% if day.holiday %} data-toggle="tooltip"{% endif %}>
                                                {% if day.holiday %}
                                                    {# the name is cut off to fit the column, the tooltip has it in full #}
                                                    <div class="planner-holiday-name text-truncate">{{ day.holiday.name }}</div>
                                                    {% if day.plannedHours > 0 %}<div class="planner-day-pct">{{ day.plannedHours }}h</div>{% endif %}
                                                {% elseif dayClass == 'planner-day-off' %}
                                                    <div class="planner-day-pct">{{ compact ? '–' : 'planner.time_off'|trans }}</div>
                                                {% elseif day.capacityHours > 0 %}
                                                    {% if not compact %}<div class="planner-day-hours">{{ day.plannedHours }}/{{ day.capacityHours }}h</div>{% endif %}
                                                    <div class="planner-day-pct">{{ day.plannedPercentage }}%</div>
                                                {% elseif day.plannedHours > 0 %}
                                                    <div class="planner-day-pct">{{ day.plannedHours }}h</div>
                                                {% else %}
                                                    <div class="planner-day-pct">&ndash;</div>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                    {% set groups = row.groups %}
                                    {% for group in groups %}
                                        {# an archived reservation keeps its row and keeps counting, but offers nothing new #}
                                        {% set offersReservation = group.reservation is not null and not group.reservation.archived %}
                                        <tr class="planner-row planner-row-details is-collapsed" data-user-id="{{ row.user.id }}"{% if group.timeOff %} data-planner-off="1"{% endif %}{% if offersReservation %} data-reservation-id="{{ group.reservation.id }}"{% endif %}{% if group.customer %} data-customer-id="{{ group.customer.id }}"{% endif %}{% if group.project %} data-project-id="{{ group.project.id }}"{% endif %}>
                                            <td class="planner-group-cell p-1 border-top-0" colspan="2">
                                                {% set groupName = group.timeOff ? 'planner.time_off'|trans : group.customerName %}
                                                <div class="d-flex justify-content-between align-items-center planner-group-label" title="{{ groupName }}{% if group.projectName %} / {{ group.projectName }}{% endif %}">
                                                    <div class="text-truncate">
                                                        <span class="fw-bold small{% if group.reservation is not null and not offersReservation %} text-muted{% endif %}">{{ groupName }}</span>{% if group.projectName %}<span class="text-muted small"> / {{ group.projectName }}</span>{% endif %}
                                                    </div>
                                                    <span class="d-flex align-items-center flex-shrink-0 ms-2">
                                                        {% set groupTentative = group.getTentativeHours(row.days) %}
                                                        <span class="text-muted small">{{ group.getPlannedHours(row.days) }}h{% if groupTentative > 0 %} <span class="planner-tentative-hours" title="{{ 'planner.tentative_hours'|trans({'%hours%': groupTentative}) }}">+{{ groupTentative }}h</span>{% endif %}</span>
                                                        {% if group.project and group.hasTentative and is_granted('edit_planner') %}
                                                            <a href="{{ path('planner_confirm_tentative', {'id': group.project.id, 'date': currentWeek|date('Y-m-d')}) }}" class="btn btn-sm btn-icon btn-ghost-success modal-ajax-form ms-1 p-0" title="{{ 'planner.confirm_tentative'|trans }}">{{ icon('success') }}</a>
                                                        {% endif %}
                                                    </span>
                                                </div>
                                            </td>
                                            {% for segment in group.getSegments(row.days) %}
                                                {% set date = segment.date %}
                                                <td colspan="{{ segment.span }}" class="position-relative align-middle border-1 day{% if segment.span == 1 and holidays[date|date('Y-m-d')] is defined %} planner-holiday{% endif %}{% if date is weekend %} weekend{% endif %}{% if date is today %} today{% endif %} p-1 {{ segment.activities is not empty ? 'has-activities' : 'no-activities' }}"{% if canCreateRow and segment.activities is empty %} data-planner-date="{{ date|date('Y-m-d') }}"{% if confirmDaysOff and row.getDay(date) is not null and not row.getDay(date).workingDay %} data-planner-non-working{% endif %}{% endif %}>
                                                    {% if canCreateRow and segment.activities is empty %}
                                                        {% set createParams = {'user': row.user.id, 'date': date|date('Y-m-d')}|merge(group.timeOff ? {'off': 1} : {})|merge(offersReservation ? {'reservation': group.reservation.id} : {}) %}
                                                        {% if group.customer %}{% set createParams = createParams|merge({'customer': group.customer.id}) %}{% endif %}
                                                        {% if group.project %}{% set createParams = createParams|merge({'project': group.project.id}) %}{% endif %}
                                                        <a href="{{ path('planner_activity_create', createParams) }}"
                                                           class="stretched-link cursor-crosshair modal-ajax-form"
                                                           title="{{ 'planner.planned_activity'|trans }}"></a>
                                                    {% endif %}
                                                    {% set segmentEnd = date.modify('+' ~ (segment.span - 1) ~ ' day') %}
                                                    {% if segment.span == 1 and group.isPlannedTwiceOn(date) %}
                                                        <span class="planner-twice text-warning" title="{{ 'planner.planned_twice'|trans }}">{{ icon('warning') }}</span>
                                                    {% endif %}
                                                    {% for activity in segment.activities %}
                                                        {% set canMove = is_granted('edit', activity) %}
                                                        {# the next part of a split planning, joined back from the marker on the border between the two #}
                                                        {% set joinable = canMove and activity.end|date('Y-m-d') == segmentEnd|date('Y-m-d') ? group.getJoinableAfter(activity) : null %}
                                                        {% if joinable is not null and not is_granted('delete', joinable) %}
                                                            {% set joinable = null %}
                                                        {% endif %}
                                                        {% set activityHours = activity.wholeDay ? 'planner.whole_day'|trans : activity.hoursPerDay ~ 'h' %}
                                                        <a href="{{ path('planner_activity_edit', {'id': activity.id, 'date': date|date('Y-m-d')}) }}"
                                                           class="planner-activity position-relative z-2 d-flex justify-content-between align-items-center px-2 py-1 rounded text-decoration-none modal-ajax-form shadow-sm{% if not loop.first %} mt-1{% endif %}{% if canMove %} planner-movable{% endif %}{% if activity.timeOff %} planner-activity-off{% endif %}{% if activity.tentative %} planner-tentative{% endif %}"
                                                           {% if not activity.timeOff %}style="background-color: {{ activity.colorSafe }}; color: {{ activity.colorSafe|font_contrast }};"{% endif %}
                                                           {% if canMove %}data-planner-move-url="{{ path('planner_activity_move', {'id': activity.id}) }}" data-planner-begin="{{ activity.begin|date('Y-m-d') }}" data-planner-end="{{ activity.end|date('Y-m-d') }}"{% if activity.daysCount > 1 %} data-planner-split-url="{{ path('planner_activity_split', {'id': activity.id}) }}"{% endif %}{% if joinable is not null %} data-planner-join-url="{{ path('planner_activity_join', {'id': activity.id, 'other': joinable.id}) }}" data-planner-join-day="{{ joinable.begin|date('Y-m-d') }}"{% endif %}{% endif %}
                                                           title="{% if activity.tentative %}{{ 'planner.tentative'|trans }}: {% endif %}{{ activity.timeOff ? 'planner.time_off'|trans : activity.name }} ({{ activityHours }}){% if activity.hasComment %}: {{ activity.comment|u.truncate(1024, '...') }}{% endif %}">
                                                            {% if canMove and activity.begin|date('Y-m-d') == date|date('Y-m-d') %}<span class="planner-handle planner-handle-start" data-planner-handle="start"></span>{% endif %}
                                                            <span class="text-truncate small">{% if activity.hasComment %}{{ icon('comment') }} {% endif %}{{ activityHours }}</span>
                                                            {% if canMove and activity.end|date('Y-m-d') == segmentEnd|date('Y-m-d') %}<span class="planner-handle planner-handle-end" data-planner-handle="end"></span>{% endif %}
                                                        </a>
                                                    {% endfor %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                    {# always keep one empty row per user, so new planning can be dragged out #}
                                    <tr class="planner-row planner-row-details is-collapsed" data-user-id="{{ row.user.id }}">
                                        <td colspan="2" class="planner-group-cell p-1 border-top-0">
                                            {% if canCreateRow %}
                                                {# opens the same dialog as an empty day of this row: today when it is shown, else the first day #}
                                                {% set addDate = row.days[('now'|date('Y-m-d'))] is defined ? 'now'|date('Y-m-d') : (row.days|first).date|date('Y-m-d') %}
                                                <div class="planner-group-label">
                                                    <a href="{{ path('planner_activity_create', {'user': row.user.id, 'date': addDate}) }}"
                                                       class="btn btn-sm modal-ajax-form planner-add-project">
                                                        {{ icon('create', true) }}{{ (groups is empty ? 'planner.add_project' : 'planner.add_another_project')|trans }}
                                                    </a>
                                                </div>
                                            {% endif %}
                                        </td>
                                        {% for day in row.days %}
                                            <td class="position-relative border-1 day{% if day.holiday %} planner-holiday{% endif %}{% if day.date is weekend %} weekend{% endif %}{% if day.date is today %} today{% endif %} p-1 no-activities"{% if canCreateRow %} data-planner-date="{{ day.date|date('Y-m-d') }}"{% if confirmDaysOff and not day.workingDay %} data-planner-non-working{% endif %}{% endif %}>
                                                {% if canCreateRow %}
                                                    <a href="{{ path('planner_activity_create', {'user': row.user.id, 'date': day.date|date('Y-m-d')}) }}"
                                                       class="stretched-link cursor-crosshair modal-ajax-form"
                                                       title="{{ 'planner.planned_activity'|trans }}"></a>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="{{ (plannerData.dateHeaders|length) + 2 }}" class="text-center p-4">
                                            {{ widgets.nothing_found() }}
                                            {% if query is defined and query.countFilter() > 0 %}
                                                <div class="mt-2">
                                                    <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}" class="btn btn-outline-secondary btn-sm">
                                                        {{ icon('cancel') }} {{ 'remove_filter'|trans }}
                                                    </a>
                                                </div>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            {% if plannerData.rows|length > 0 %}
                                <tfoot>
                                    <tr class="summary">
                                        <td class="text-right p-1" colspan="2">
                                            <div>{{ plannerData.totalPlannedHours }}h / {{ plannerData.totalCapacityHours }}h</div>
                                            {% if plannerData.totalTentativeHours > 0 %}
                                                <div class="small planner-tentative-hours fw-normal">{{ 'planner.tentative_hours'|trans({'%hours%': plannerData.totalTentativeHours}) }}</div>
                                            {% endif %}
                                            {% if plannerData.totalActualHours > 0 %}
                                                <div class="small text-muted fw-normal">{{ 'planner.actual_hours'|trans }}: {{ plannerData.totalActualHours }}h</div>
                                            {% endif %}
                                        </td>
                                        {% for day in plannerData.dateHeaders %}
                                            {% set dayTotalPlanned = plannerData.getTotalPlannedHoursForDay(day) %}
                                            {% set dayTotalActual = plannerData.getTotalActualHoursForDay(day) %}
                                            {% set dayTotalTentative = plannerData.getTotalTentativeHoursForDay(day) %}
                                            <td class="align-top text-center{% if day is today %} today{% endif %} p-1">
                                                <div>{{ dayTotalPlanned }}h</div>
                                                {% if dayTotalTentative > 0 %}
                                                    <div class="small planner-tentative-hours fw-normal" title="{{ 'planner.tentative_hours'|trans({'%hours%': dayTotalTentative}) }}">+{{ dayTotalTentative }}h</div>
                                                {% endif %}
                                                {% if dayTotalActual > 0 %}
                                                    <div class="small text-muted fw-normal">{{ dayTotalActual }}h</div>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                </tfoot>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

