{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        function getPlannerUserToggleStates() {
            try {
                if (typeof KimaiStorage !== 'undefined') {
                    return KimaiStorage.get('planner_user_toggle_states') || {};
                }
                const data = localStorage.getItem('planner_user_toggle_states');
                return data ? JSON.parse(data) : {};
            } catch (e) {
                return {};
            }
        }

        function savePlannerUserToggleState(userId, isExpanded) {
            try {
                const states = getPlannerUserToggleStates();
                states[userId] = isExpanded;
                if (typeof KimaiStorage !== 'undefined') {
                    KimaiStorage.set('planner_user_toggle_states', states);
                } else {
                    localStorage.setItem('planner_user_toggle_states', JSON.stringify(states));
                }
            } catch (e) {
                // ignore storage error
            }
        }

        function restorePlannerUserToggleStates() {
            const states = getPlannerUserToggleStates();
            document.querySelectorAll('.planner-row[data-user-id]').forEach(function(row) {
                const userId = row.getAttribute('data-user-id');
                if (userId && states[userId] !== undefined) {
                    const isExpanded = !!states[userId];
                    row.classList.toggle('is-expanded', isExpanded);
                    row.classList.toggle('is-collapsed', !isExpanded);
                    const toggleBtn = row.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                    }
                }
            });
        }

        document.addEventListener('kimai.initialized', function() {
            // Soft reload (reloads content area without full browser refresh)
            KimaiReloadPageWidget.create('kimai.plannerActivityUpdate');
            restorePlannerUserToggleStates();
        });

        document.addEventListener('kimai.reloadPage', function() {
            restorePlannerUserToggleStates();
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', restorePlannerUserToggleStates);
        } else {
            restorePlannerUserToggleStates();
        }

        document.addEventListener('click', function(e) {
            const toggleAllBtn = e.target.closest('.planner-toggle-all, .planner-expand-all');
            if (toggleAllBtn) {
                e.preventDefault();
                const detailsRows = Array.from(document.querySelectorAll('tr.planner-row-details[data-user-id]'));
                const anyCollapsed = detailsRows.some(function(r) {
                    return r.classList.contains('is-collapsed') || !r.classList.contains('is-expanded');
                });
                const willExpand = detailsRows.length === 0 || anyCollapsed;

                const states = getPlannerUserToggleStates();
                document.querySelectorAll('.planner-row[data-user-id]').forEach(function(r) {
                    r.classList.toggle('is-expanded', willExpand);
                    r.classList.toggle('is-collapsed', !willExpand);
                    const toggleBtn = r.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', willExpand ? 'true' : 'false');
                    }
                    const userId = r.getAttribute('data-user-id');
                    if (userId) {
                        states[userId] = willExpand;
                    }
                });
                try {
                    if (typeof KimaiStorage !== 'undefined') {
                        KimaiStorage.set('planner_user_toggle_states', states);
                    } else {
                        localStorage.setItem('planner_user_toggle_states', JSON.stringify(states));
                    }
                } catch (err) {
                    // ignore storage error
                }
                return;
            }

            const userCell = e.target.closest('.planner-user-cell');
            if (!userCell) {
                return;
            }

            if (e.target.closest('a')) {
                return;
            }

            e.preventDefault();

            const row = userCell.closest('tr');
            if (!row) {
                return;
            }

            const userId = row.getAttribute('data-user-id');
            const isExpanded = row.classList.contains('is-expanded');
            const willExpand = !isExpanded;

            if (userId) {
                document.querySelectorAll('.planner-row[data-user-id="' + userId + '"]').forEach(function(r) {
                    r.classList.toggle('is-expanded', willExpand);
                    r.classList.toggle('is-collapsed', !willExpand);
                    const toggleBtn = r.querySelector('.planner-user-toggle');
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', willExpand ? 'true' : 'false');
                    }
                });
                savePlannerUserToggleState(userId, willExpand);
            }
        });

        /*
         * Drag over empty day cells of one row to create a planned activity spanning several days.
         * A plain click (no drag) keeps opening the single-day dialog via the cell's link.
         * Planning a day the user does not work by contract has to be confirmed first.
         */
        (function () {
            const CELL = 'td.day[data-planner-date]';
            let drag = null;
            let suppressClick = false;
            let confirmedClick = false;
            let keepPreview = false;

            function escapeHtml(text) {
                const el = document.createElement('span');
                el.textContent = text;
                return el.innerHTML;
            }

            function confirmDaysOff(row, cells, proceed, cancel) {
                const table = row.closest('table[data-planner-create-url]');
                // time off on a day off is no mistake, it needs no confirmation
                if (!table || row.dataset.plannerOff || !cells.every(function (cell) { return cell.hasAttribute('data-planner-non-working'); })) {
                    proceed();
                    return;
                }
                const summary = table.querySelector('tr.planner-row-summary[data-user-id="' + row.dataset.userId + '"]');
                const name = summary ? summary.dataset.plannerUserName : '';
                const question = cells.length > 1 ? table.dataset.plannerDaysOffQuestion : table.dataset.plannerDayOffQuestion;
                const message = question.replace('%name%', function () { return name; });
                if (!window.kimai) {
                    if (window.confirm(message)) {
                        proceed();
                    } else {
                        cancel();
                    }
                    return;
                }
                window.kimai.getPlugin('alert').question(escapeHtml(message), function (confirmed) {
                    keepPreview = confirmed;
                    if (confirmed) {
                        proceed();
                    } else {
                        cancel();
                    }
                });
            }

            function cellsOf(row) {
                return Array.from(row.querySelectorAll(CELL));
            }

            function range(d) {
                return d.start <= d.current ? [d.start, d.current] : [d.current, d.start];
            }

            function paint(d) {
                const bounds = range(d);
                const selected = cellsOf(d.row).filter(function (cell) {
                    const date = cell.dataset.plannerDate;
                    const inRange = date >= bounds[0] && date <= bounds[1];
                    cell.classList.toggle('planner-drag-selected', inRange);
                    return inRange;
                });
                removePreview();
                if (selected.length < 2) {
                    return;
                }
                // one block spanning the selected cells, like a saved activity
                const first = selected[0].getBoundingClientRect();
                const last = selected[selected.length - 1].getBoundingClientRect();
                const pad = 4;
                const preview = document.createElement('div');
                preview.className = 'planner-drag-preview d-flex align-items-center px-2 py-1 rounded shadow-sm';
                preview.style.left = pad + 'px';
                preview.style.width = (last.right - first.left - 2 * pad) + 'px';
                selected[0].appendChild(preview);
            }

            function removePreview() {
                document.querySelectorAll('.planner-drag-preview').forEach(function (el) {
                    el.remove();
                });
            }

            function reset() {
                removePreview();
                document.querySelectorAll('.planner-drag-selected').forEach(function (cell) {
                    cell.classList.remove('planner-drag-selected');
                });
                document.body.classList.remove('planner-dragging');
                drag = null;
            }

            function openCreateDialog(d) {
                const table = d.row.closest('table[data-planner-create-url]');
                if (!table) {
                    return;
                }
                const bounds = range(d);
                const params = new URLSearchParams({user: d.row.dataset.userId, date: bounds[0], end: bounds[1]});
                if (d.row.dataset.plannerOff) {
                    params.set('off', '1');
                }
                if (d.row.dataset.reservationId) {
                    params.set('reservation', d.row.dataset.reservationId);
                }
                if (d.row.dataset.customerId) {
                    params.set('customer', d.row.dataset.customerId);
                }
                if (d.row.dataset.projectId) {
                    params.set('project', d.row.dataset.projectId);
                }
                // reuse Kimai's delegated click handler for modal links
                const link = document.createElement('a');
                link.className = 'modal-ajax-form';
                link.href = table.dataset.plannerCreateUrl + '?' + params.toString();
                link.style.display = 'none';
                document.body.appendChild(link);
                link.click();
                link.remove();
            }

            document.addEventListener('mousedown', function (e) {
                if (e.button !== 0) {
                    return;
                }
                const cell = e.target.closest(CELL);
                if (!cell) {
                    return;
                }
                reset();
                drag = {row: cell.closest('tr'), start: cell.dataset.plannerDate, current: cell.dataset.plannerDate};
            });

            // the cell's stretched link would otherwise start a native link drag, which swallows mouseover and mouseup
            document.addEventListener('dragstart', function (e) {
                if (e.target.closest && e.target.closest(CELL)) {
                    e.preventDefault();
                }
            });

            document.addEventListener('mouseover', function (e) {
                if (drag === null) {
                    return;
                }
                const cell = e.target.closest(CELL);
                if (!cell || cell.closest('tr') !== drag.row || cell.dataset.plannerDate === drag.current) {
                    return;
                }
                drag.current = cell.dataset.plannerDate;
                if (drag.current !== drag.start) {
                    document.body.classList.add('planner-dragging');
                }
                paint(drag);
            });

            document.addEventListener('mouseup', function () {
                if (drag === null) {
                    return;
                }
                const finished = drag;
                reset();
                if (finished.start === finished.current) {
                    return;
                }
                // keep the preview visible while the dialogs are open
                paint(finished);
                const bounds = range(finished);
                const cells = cellsOf(finished.row).filter(function (cell) {
                    return cell.dataset.plannerDate >= bounds[0] && cell.dataset.plannerDate <= bounds[1];
                });
                confirmDaysOff(finished.row, cells, function () {
                    openCreateDialog(finished);
                }, reset);
                // the click event following mouseup must not open the single-day dialog as well
                suppressClick = true;
                setTimeout(function () { suppressClick = false; }, 0);
            });

            document.addEventListener('click', function (e) {
                if (suppressClick) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            }, true);

            // a single click on a day off asks before the cell's link opens the dialog
            document.addEventListener('click', function (e) {
                if (e.defaultPrevented || confirmedClick) {
                    return;
                }
                const link = e.target.closest('td.day[data-planner-non-working] > a.modal-ajax-form');
                if (!link) {
                    return;
                }
                e.preventDefault();
                e.stopPropagation();
                confirmDaysOff(link.closest('tr'), [link.parentElement], function () {
                    confirmedClick = true;
                    link.click();
                    confirmedClick = false;
                }, function () {});
            }, true);

            document.addEventListener('hidden.bs.modal', function () {
                // the confirmation closing must not remove the preview of the dialog it opens
                if (keepPreview) {
                    keepPreview = false;
                    return;
                }
                if (drag === null) {
                    reset();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && drag !== null) {
                    reset();
                }
            });
        })();

        /*
         * Drag a planned activity to another day/row, or drag its left/right handle to extend or shorten it.
         * Only whole days are moved, the hours per day of the activity stay the same.
         * The pointer column is found through the day headers, because merged cells do not map to a single day.
         */
        (function () {
            const THRESHOLD = 4;
            let move = null;
            let suppressClick = false;

            function addDays(date, days) {
                const d = new Date(date + 'T00:00:00Z');
                d.setUTCDate(d.getUTCDate() + days);
                return d.toISOString().slice(0, 10);
            }

            function diffDays(a, b) {
                return Math.round((Date.parse(b + 'T00:00:00Z') - Date.parse(a + 'T00:00:00Z')) / 86400000);
            }

            function headerAt(x) {
                const headers = document.querySelectorAll('th[data-planner-day]');
                for (let i = 0; i < headers.length; i++) {
                    const r = headers[i].getBoundingClientRect();
                    if (x >= r.left && x < r.right) {
                        return headers[i];
                    }
                }
                return null;
            }

            function headerOf(date) {
                return document.querySelector('th[data-planner-day="' + date + '"]');
            }

            function rowAt(y) {
                const rows = document.querySelectorAll('tr.planner-row-details');
                for (let i = 0; i < rows.length; i++) {
                    const r = rows[i].getBoundingClientRect();
                    if (r.height > 0 && y >= r.top && y < r.bottom) {
                        return rows[i];
                    }
                }
                return null;
            }

            function removePreview() {
                document.querySelectorAll('.planner-move-preview').forEach(function (el) {
                    el.remove();
                });
            }

            function reset() {
                removePreview();
                document.body.classList.remove('planner-moving');
                move = null;
            }

            // new dates for the pointer position, null when the pointer is outside the day columns
            function target(m, x, y) {
                const header = headerAt(x);
                const row = rowAt(y);
                if (header === null || row === null) {
                    return null;
                }
                const delta = diffDays(m.grabbedDay, header.dataset.plannerDay);
                let begin = m.begin;
                let end = m.end;
                if (m.handle === 'start') {
                    begin = addDays(m.begin, delta);
                    if (begin > m.end) {
                        begin = m.end;
                    }
                } else if (m.handle === 'end') {
                    end = addDays(m.end, delta);
                    if (end < m.begin) {
                        end = m.begin;
                    }
                } else {
                    begin = addDays(m.begin, delta);
                    end = addDays(m.end, delta);
                }
                return {begin: begin, end: end, row: m.handle === null ? row : m.row};
            }

            function paint(m, t) {
                removePreview();
                if (t === null) {
                    return;
                }
                const first = headerOf(t.begin);
                const last = headerOf(t.end);
                if (first === null && last === null) {
                    return;
                }
                // a range reaching beyond the displayed weeks is cut at the edge of the grid
                const all = document.querySelectorAll('th[data-planner-day]');
                const rowRect = t.row.getBoundingClientRect();
                const left = (first || all[0]).getBoundingClientRect().left;
                const right = (last || all[all.length - 1]).getBoundingClientRect().right;
                const preview = document.createElement('div');
                preview.className = 'planner-move-preview';
                preview.style.left = left + 'px';
                preview.style.width = (right - left) + 'px';
                preview.style.top = (rowRect.top + 2) + 'px';
                preview.style.height = (rowRect.height - 4) + 'px';
                document.body.appendChild(preview);
            }

            function save(m, t) {
                const table = document.querySelector('table[data-planner-move-token]');
                const body = new URLSearchParams({_token: table.dataset.plannerMoveToken, begin: t.begin, end: t.end});
                if (t.row.dataset.userId !== m.row.dataset.userId) {
                    body.set('user', t.row.dataset.userId);
                }
                // dropped on a reservation's row the planning becomes that reservation, on a project's row that project
                if (t.row.dataset.reservationId && t.row.dataset.reservationId !== m.row.dataset.reservationId) {
                    body.set('reservation', t.row.dataset.reservationId);
                } else if (t.row.dataset.customerId && (t.row.dataset.customerId !== m.row.dataset.customerId || t.row.dataset.projectId !== m.row.dataset.projectId)) {
                    body.set('customer', t.row.dataset.customerId);
                    if (t.row.dataset.projectId) {
                        body.set('project', t.row.dataset.projectId);
                    }
                }
                fetch(m.url, {method: 'POST', body: body, headers: {'X-Requested-With': 'XMLHttpRequest'}})
                    .then(function (response) {
                        if (response.ok) {
                            document.dispatchEvent(new CustomEvent('kimai.plannerActivityUpdate'));
                            return null;
                        }
                        return response.json().catch(function () { return {}; }).then(function (data) {
                            const message = response.status === 422 && data.message ? data.message : table.dataset.plannerMoveError;
                            if (window.kimai) {
                                window.kimai.getPlugin('alert').error(message);
                            } else {
                                window.alert(message);
                            }
                        });
                    })
                    .catch(function () {
                        window.alert(table.dataset.plannerMoveError);
                    });
            }

            document.addEventListener('mousedown', function (e) {
                if (e.button !== 0) {
                    return;
                }
                const activity = e.target.closest('.planner-activity[data-planner-move-url]');
                const header = headerAt(e.clientX);
                if (!activity || header === null) {
                    return;
                }
                const handle = e.target.closest('[data-planner-handle]');
                move = {
                    url: activity.dataset.plannerMoveUrl,
                    begin: activity.dataset.plannerBegin,
                    end: activity.dataset.plannerEnd,
                    handle: handle ? handle.dataset.plannerHandle : null,
                    row: activity.closest('tr'),
                    grabbedDay: header.dataset.plannerDay,
                    startX: e.clientX,
                    startY: e.clientY,
                    active: false,
                    target: null
                };
            });

            // the activity is a link, a native link drag would swallow mousemove and mouseup
            document.addEventListener('dragstart', function (e) {
                if (e.target.closest && e.target.closest('.planner-movable')) {
                    e.preventDefault();
                }
            });

            document.addEventListener('mousemove', function (e) {
                if (move === null) {
                    return;
                }
                if (!move.active) {
                    if (Math.abs(e.clientX - move.startX) < THRESHOLD && Math.abs(e.clientY - move.startY) < THRESHOLD) {
                        return;
                    }
                    move.active = true;
                    document.body.classList.add('planner-moving');
                }
                move.target = target(move, e.clientX, e.clientY);
                paint(move, move.target);
            });

            document.addEventListener('mouseup', function () {
                if (move === null) {
                    return;
                }
                const finished = move;
                reset();
                if (!finished.active) {
                    return;
                }
                // the click following mouseup must not open the edit dialog
                suppressClick = true;
                setTimeout(function () { suppressClick = false; }, 0);

                const t = finished.target;
                if (t === null || (t.begin === finished.begin && t.end === finished.end && t.row === finished.row)) {
                    return;
                }
                save(finished, t);
            });

            document.addEventListener('click', function (e) {
                if (suppressClick) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            }, true);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && move !== null) {
                    reset();
                }
            });
        })();

        /**
         * Split a multi-day activity in two, or join two parts of a split planning back into one.
         * Hovering the border between two days of an activity shows scissors, hovering the gap between two parts
         * that are the same planning shows a link; a click splits or joins there. Each undoes the other, so there
         * is no confirmation. The day borders come from the day headers, like moving does.
         */
        (function () {
            const SPLIT_ZONE = 6;
            // only the gap between the two bars (their cells' padding), so the resize handles next to it stay reachable
            const JOIN_ZONE = 3;
            let hint = null;

            function removeHint() {
                if (hint !== null) {
                    hint.remove();
                    hint = null;
                }
            }

            function borderOf(day) {
                const header = document.querySelector('th[data-planner-day="' + day + '"]');
                return header === null ? null : header.getBoundingClientRect().left;
            }

            // the marker for the pointer position in a row: a border inside a bar (split) or between two parts (join)
            function markerAt(row, x, y) {
                const bars = row.querySelectorAll('.planner-activity[data-planner-split-url], .planner-activity[data-planner-join-url]');
                for (let i = 0; i < bars.length; i++) {
                    const bar = bars[i];
                    const rect = bar.getBoundingClientRect();
                    if (y < rect.top || y > rect.bottom) {
                        continue;
                    }
                    if (bar.dataset.plannerJoinUrl) {
                        const border = borderOf(bar.dataset.plannerJoinDay);
                        if (border !== null && Math.abs(border - x) <= JOIN_ZONE) {
                            return {type: 'join', bar: bar, day: bar.dataset.plannerJoinDay, x: border, rect: rect};
                        }
                    }
                    if (bar.dataset.plannerSplitUrl && x > rect.left + SPLIT_ZONE && x < rect.right - SPLIT_ZONE) {
                        const headers = document.querySelectorAll('th[data-planner-day]');
                        for (let j = 0; j < headers.length; j++) {
                            const day = headers[j].dataset.plannerDay;
                            if (day <= bar.dataset.plannerBegin || day > bar.dataset.plannerEnd) {
                                continue;
                            }
                            const border = headers[j].getBoundingClientRect().left;
                            if (border > rect.left + SPLIT_ZONE && border < rect.right - SPLIT_ZONE && Math.abs(border - x) <= SPLIT_ZONE) {
                                return {type: 'split', bar: bar, day: day, x: border, rect: rect};
                            }
                        }
                    }
                }
                return null;
            }

            function showHint(marker) {
                if (hint !== null && hint.plannerMarker.type === marker.type && hint.plannerMarker.bar === marker.bar && hint.plannerMarker.day === marker.day) {
                    return;
                }
                removeHint();
                const table = marker.bar.closest('table');
                hint = document.createElement('div');
                hint.className = 'planner-split-hint planner-' + marker.type + '-hint';
                hint.title = marker.type === 'join' ? table.dataset.plannerJoinTitle : table.dataset.plannerSplitTitle;
                hint.plannerMarker = marker;
                const width = marker.type === 'join' ? 8 : 16;
                hint.style.left = (marker.x - width / 2) + 'px';
                hint.style.width = width + 'px';
                hint.style.top = (marker.rect.top - 3) + 'px';
                hint.style.height = (marker.rect.height + 6) + 'px';
                const line = document.createElement('span');
                line.className = 'planner-split-line';
                const icon = document.createElement('i');
                icon.className = marker.type === 'join' ? 'fas fa-link' : 'fas fa-scissors';
                hint.append(line, icon);
                document.body.appendChild(hint);
            }

            function send(marker) {
                const table = marker.bar.closest('table');
                const url = marker.type === 'join' ? marker.bar.dataset.plannerJoinUrl : marker.bar.dataset.plannerSplitUrl;
                const body = new URLSearchParams({_token: table.dataset.plannerMoveToken});
                if (marker.type === 'split') {
                    body.set('date', marker.day);
                }
                fetch(url, {method: 'POST', body: body, headers: {'X-Requested-With': 'XMLHttpRequest'}})
                    .then(function (response) {
                        if (response.ok) {
                            document.dispatchEvent(new CustomEvent('kimai.plannerActivityUpdate'));
                        } else if (window.kimai) {
                            window.kimai.getPlugin('alert').error(table.dataset.plannerMoveError);
                        } else {
                            window.alert(table.dataset.plannerMoveError);
                        }
                    })
                    .catch(function () {
                        window.alert(table.dataset.plannerMoveError);
                    });
            }

            document.addEventListener('mousemove', function (e) {
                // a slight movement while clicking the marker must not remove it
                if (e.target.closest('.planner-split-hint')) {
                    return;
                }
                if (e.buttons !== 0 || document.body.classList.contains('planner-moving') || document.body.classList.contains('planner-dragging')) {
                    removeHint();
                    return;
                }
                const row = e.target.closest('tr.planner-row-details');
                const marker = row ? markerAt(row, e.clientX, e.clientY) : null;
                if (marker === null) {
                    removeHint();
                    return;
                }
                showHint(marker);
            });

            document.addEventListener('click', function (e) {
                const target = e.target.closest('.planner-split-hint');
                if (target === null) {
                    return;
                }
                e.preventDefault();
                const marker = target.plannerMarker;
                removeHint();
                send(marker);
            });

            // the marker is positioned on the viewport
            window.addEventListener('scroll', removeHint, true);
            document.addEventListener('kimai.reloadPage', removeHint);
        })();
    </script>
{% endblock %}
